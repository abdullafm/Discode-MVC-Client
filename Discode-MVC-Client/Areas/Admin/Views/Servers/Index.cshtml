@model AdminServerListVM
@{
    var tabs = new[]
    {
        (Key: "", Label: "All servers"),
        (Key: "banned", Label: "Servers with bans")
    };
    var current = tabs.First(x => x.Key == Model.Filter);
    ViewData["Title"] = Model.Filter == "" ? "Servers" : current.Label;
    ViewData["Section"] = "servers";
}
<div class="adm-tabs">
    @foreach (var tab in tabs)
    {
        <a class="@(tab.Key == Model.Filter ? "on" : "")" asp-area="Admin" asp-controller="Servers" asp-action="Index" asp-route-filter="@tab.Key">@tab.Label</a>
    }
</div>

<div class="adm-list-head">
    <form method="get" class="adm-search" asp-area="Admin" asp-controller="Servers" asp-action="Index">
        <input type="hidden" name="filter" value="@Model.Filter">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="search" value="@Model.Search" placeholder="Search by server or owner name" autocomplete="off">
    </form>
    <span class="adm-count">@Model.Total @(Model.Filter == "" ? ViewData["Title"]?.ToString()?.ToLowerInvariant() : current.Label.ToLowerInvariant())</span>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Error</p>
}

<div class="adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>Server</th>
                <th>Owner</th>
                <th>Visibility</th>
                <th>Members</th>
                <th>Bans</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var server in Model.Items)
            {
                <tr>
                    <td>
                        <div class="adm-person">
                            @if (string.IsNullOrWhiteSpace(server.IconUrl))
                            {
                                <span class="adm-letter">@server.Name.Trim().Substring(0, 1).ToUpperInvariant()</span>
                            }
                            else
                            {
                                <img src="@server.IconUrl" alt="">
                            }
                            <span><strong>@server.Name</strong><small>#@server.Id</small></span>
                        </div>
                    </td>
                    <td class="adm-muted">@server.OwnerUserName</td>
                    <td><span class="adm-chip @(server.IsPrivate ? "is-private" : "is-public")">@(server.IsPrivate ? "Private" : "Public")</span></td>
                    <td>@server.Members</td>
                    <td><span class="@(server.Bans > 0 ? "adm-bad" : "adm-muted")">@server.Bans</span></td>
                    <td class="adm-muted">@server.CreatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="adm-empty">No servers found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="adm-pager">
        <a class="@(Model.Page <= 1 ? "is-off" : "")" asp-area="Admin" asp-controller="Servers" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)"><i class="fa-solid fa-chevron-left"></i></a>
        <span>Page @Model.Page / @Model.TotalPages</span>
        <a class="@(Model.Page >= Model.TotalPages ? "is-off" : "")" asp-area="Admin" asp-controller="Servers" asp-action="Index" asp-route-filter="@Model.Filter" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)"><i class="fa-solid fa-chevron-right"></i></a>
    </div>
}
