@model AdminServerMemberListVM
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Error</p>
}
else
{
    <div class="adm-mini-members">
        @foreach (var member in Model.Items)
        {
            <div class="adm-person">
                <img src="@(string.IsNullOrWhiteSpace(member.AvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : member.AvatarUrl)" alt="">
                <span><strong>@(string.IsNullOrWhiteSpace(member.DisplayName) ? member.UserName : member.DisplayName)@(member.IsOwner ? " 👑" : "")</strong><small>@member.UserName &middot; joined @member.JoinedAt.ToString("yyyy-MM-dd")</small></span>
            </div>
        }
        @if (Model.Items.Count == 0)
        {
            <p class="adm-empty">@(Model.Search.Length > 0 ? "No member matches your search." : "No members.")</p>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="adm-pager adm-pager-tight">
            <button type="button" class="@(Model.Page <= 1 ? "is-off" : "")" data-members-page="@(Model.Page - 1)" aria-label="Previous"><i class="fa-solid fa-chevron-left"></i></button>
            <span>@Model.Page / @Model.TotalPages</span>
            <button type="button" class="@(Model.Page >= Model.TotalPages ? "is-off" : "")" data-members-page="@(Model.Page + 1)" aria-label="Next"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
    }
}
