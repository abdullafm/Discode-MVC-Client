@model AdminUserDetailVM
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.UserName) ? "Member" : Model.DisplayName;
    ViewData["Section"] = "users";
    string KindClass(string kind) => kind switch
    {
        "Ban" or "ServerBan" or "Delete" or "ServerDelete" or "LiveBan" or "LiveEnd" => "is-banned",
        "Warn" or "Timeout" or "ChangeRole" => "is-timeout",
        "Unban" or "ServerUnban" or "ClearTimeout" or "LiveUnban" => "is-public",
        _ => ""
    };
}
<a class="adm-back-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Back to members</a>

@if (!string.IsNullOrEmpty(Model.Notice))
{
    <p class="adm-notice"><i class="fa-solid fa-circle-check"></i> @Model.Notice</p>
}
@if (!string.IsNullOrEmpty(Model.Warning))
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Warning</p>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Error</p>
}
else
{
    <div class="adm-detail-head" data-user-id="@Model.Id">
        <div class="adm-person adm-person-big">
            @if (string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img src="@Url.Content("~/assets/img/img-icon-profile.jpeg")" alt="">
            }
            else
            {
                <span class="adm-zoom-wrap" title="Click to enlarge"><img class="adm-zoom" src="@Model.AvatarUrl" alt="@Model.DisplayName"></span>
            }
            <span>
                <strong>@Model.DisplayName</strong>
                <small>@@@Model.UserName &middot; @Model.Email</small>
            </span>
        </div>
        <div class="adm-detail-chips">
            @foreach (var role in Model.Roles)
            {
                <span class="adm-chip role-@role.ToLowerInvariant()">@role</span>
            }
            @if (Model.IsDeleted)
            {
                <span class="adm-chip is-banned">Deleted</span>
            }
            @if (Model.IsBanned)
            {
                <span class="adm-chip is-banned">Banned</span>
            }
            @if (Model.TimedOut)
            {
                <span class="adm-chip is-timeout">Timed out</span>
            }
            @if (Model.LiveBanned)
            {
                <span class="adm-chip is-banned">No live</span>
            }
            <span class="adm-chip @(Model.IsPublic ? "is-public" : "is-private")">@(Model.IsPublic ? "Public" : "Private")</span>
        </div>
    </div>

    @if (Model.IsBanned)
    {
        <div class="adm-ban-banner">
            <i class="fa-solid fa-ban"></i>
            <div>
                <strong>@(Model.IsDeleted ? "This account is deleted" : "This member is banned")</strong>
                <p>@Model.BanReason</p>
                <small>
                    @(Model.BannedUntil is null ? "Permanent." : "Until " + Model.BannedUntil.Value.ToString("yyyy-MM-dd HH:mm") + " UTC.")
                    @(string.IsNullOrEmpty(Model.BannedByUserName) ? "" : "By " + Model.BannedByUserName + ".")
                    They cannot sign in while the ban is active.
                </small>
            </div>
        </div>
    }
    @if (Model.TimedOut)
    {
        <div class="adm-ban-banner is-amber">
            <i class="fa-solid fa-hourglass-half"></i>
            <div>
                <strong>This member is timed out</strong>
                <p>@Model.TimeoutReason</p>
                <small>Until @Model.TimeoutUntil!.Value.ToString("yyyy-MM-dd HH:mm") UTC. They can read, but cannot send messages, posts or comments.</small>
            </div>
        </div>
    }

    <div class="adm-metrics">
        <div><strong>@Model.ServersJoined</strong><span>Servers</span></div>
        <div><strong>@Model.Posts</strong><span>Posts</span></div>
        <div><strong>@Model.Comments</strong><span>Comments</span></div>
        <div><strong class="@(Model.Warnings > 0 ? "adm-warn" : "")">@Model.Warnings</strong><span>Warnings</span></div>
        <div><strong class="@(Model.ReportsAgainst > 0 ? "adm-bad" : "")">@Model.ReportsAgainst</strong><span>Reports against</span></div>
        <div><strong class="@(Model.BansReceived > 0 ? "adm-bad" : "")">@Model.BansReceived</strong><span>Server bans</span></div>
    </div>

    <div class="adm-detail-grid">
        <div class="adm-panel">
            <h3>About</h3>
            <dl class="adm-dl">
                <dt>Username</dt><dd>@@@Model.UserName</dd>
                <dt>Email</dt><dd>@Model.Email</dd>
                <dt>Public ID</dt><dd>@Model.PublicId</dd>
                <dt>Joined</dt><dd>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt>Bio</dt><dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio" : Model.Bio)</dd>
            </dl>

            <div class="adm-history">
                <h3>Warnings <span class="adm-count-pill">@Model.Warnings</span></h3>
                @if (Model.RecentWarnings.Count == 0)
                {
                    <p class="adm-empty-small">No warnings.</p>
                }
                @foreach (var warning in Model.RecentWarnings)
                {
                    <div class="adm-log-row">
                        <span class="adm-chip is-timeout">Warning</span>
                        <div>
                            <strong>@warning.Reason</strong>
                            <small>@warning.IssuedByUserName &middot; @warning.CreatedAt.ToString("yyyy-MM-dd HH:mm") &middot; @(warning.Seen ? "seen" : "not seen yet")</small>
                        </div>
                    </div>
                }

                <h3>History</h3>
                @if (Model.History.Count == 0)
                {
                    <p class="adm-empty-small">No admin actions yet.</p>
                }
                @foreach (var action in Model.History)
                {
                    <div class="adm-log-row">
                        <span class="adm-chip @KindClass(action.Kind)">@action.Kind</span>
                        <div>
                            <strong>@action.Reason</strong>
                            <small>@action.AdminUserName &middot; @action.CreatedAt.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(action.Details) ? "" : " · " + action.Details)</small>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="adm-panel adm-actions-panel">
            <h3>Actions</h3>
            @if (Model.CanChangeRole)
            {
                var currentRole = Model.Roles.FirstOrDefault() ?? "Member";
                <details class="adm-action">
                    <summary><i class="fa-solid fa-user-shield"></i> Role: @currentRole</summary>
                    <form method="post" asp-area="Admin" asp-controller="Users" asp-action="ChangeRole" asp-route-id="@Model.Id" data-confirm="They are signed out right now and get the new permissions the next time they sign in." data-confirm-title="Change this role?" data-confirm-button="Change role" data-confirm-tone="warning" data-confirm-icon="fa-user-shield">
                        <select name="role" class="adm-select">
                            @foreach (var option in new[] { "Member", "Admin", "SuperAdmin" })
                            {
                                <option value="@option" selected="@(option == currentRole)">@option</option>
                            }
                        </select>
                        <button type="submit" class="adm-btn is-amber"><i class="fa-solid fa-user-shield"></i> Change role</button>
                    </form>
                </details>
            }
            @if (Model.IsDeleted)
            {
                <p class="adm-empty-small">This account was deleted. Nothing more can be done to it.</p>
            }
            else if (!Model.CanModerate)
            {
                <p class="adm-empty-small">You cannot moderate this account: it is your own, or it belongs to an Admin or SuperAdmin.</p>
            }
            else
            {
                <details class="adm-action">
                    <summary><i class="fa-solid fa-triangle-exclamation"></i> Warn</summary>
                    <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Warn" asp-route-id="@Model.Id" data-confirm="The member sees this warning the next time they are online, or right away if they are." data-confirm-title="Send this warning?" data-confirm-button="Send warning" data-confirm-tone="warning" data-confirm-icon="fa-triangle-exclamation">
                        <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="What did they do?" required></textarea>
                        <button type="submit" class="adm-btn is-amber"><i class="fa-solid fa-triangle-exclamation"></i> Send warning</button>
                    </form>
                </details>

                @if (Model.TimedOut)
                {
                    <form method="post" asp-area="Admin" asp-controller="Users" asp-action="ClearTimeout" asp-route-id="@Model.Id" class="adm-action-row" data-confirm="They will be able to send messages, posts and comments again." data-confirm-title="Remove the timeout?" data-confirm-button="Remove timeout" data-confirm-tone="success" data-confirm-icon="fa-rotate-left">
                        <button type="submit" class="adm-btn is-success"><i class="fa-solid fa-rotate-left"></i> Remove timeout</button>
                    </form>
                }
                else
                {
                    <details class="adm-action">
                        <summary><i class="fa-solid fa-hourglass-half"></i> Timeout</summary>
                        <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Timeout" asp-route-id="@Model.Id" data-confirm="They can still read, but cannot send messages, posts or comments until the time is over." data-confirm-title="Time this member out?" data-confirm-button="Timeout" data-confirm-tone="warning" data-confirm-icon="fa-hourglass-half">
                            <select name="minutes" class="adm-select">
                                <option value="10">10 minutes</option>
                                <option value="60" selected>1 hour</option>
                                <option value="1440">1 day</option>
                                <option value="10080">7 days</option>
                            </select>
                            <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="Reason for the timeout" required></textarea>
                            <button type="submit" class="adm-btn is-amber"><i class="fa-solid fa-hourglass-half"></i> Timeout</button>
                        </form>
                    </details>
                }

                <details class="adm-action">
                    <summary><i class="fa-solid fa-right-from-bracket"></i> Kick</summary>
                    <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Kick" asp-route-id="@Model.Id" data-confirm="They are signed out of every device right now. They can sign in again." data-confirm-title="Kick this member?" data-confirm-button="Kick" data-confirm-tone="danger" data-confirm-icon="fa-right-from-bracket">
                        <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="Reason for the kick" required></textarea>
                        <button type="submit" class="adm-btn is-danger"><i class="fa-solid fa-right-from-bracket"></i> Kick</button>
                    </form>
                </details>

                @if (Model.CanBan)
                {
                    @if (Model.LiveBanned)
                    {
                        <form method="post" asp-area="Admin" asp-controller="Users" asp-action="LiveUnban" asp-route-id="@Model.Id" class="adm-action-row" data-confirm="They can start live streams again." data-confirm-title="Allow live streams again?" data-confirm-button="Allow" data-confirm-tone="success" data-confirm-icon="fa-tower-broadcast">
                            <button type="submit" class="adm-btn is-success"><i class="fa-solid fa-tower-broadcast"></i> Allow live streams</button>
                        </form>
                    }
                    else
                    {
                        <details class="adm-action">
                            <summary><i class="fa-solid fa-tower-broadcast"></i> Ban from going live</summary>
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="LiveBan" asp-route-id="@Model.Id" data-confirm="A stream that is running is closed and they cannot start another one until the ban ends." data-confirm-title="Ban from going live?" data-confirm-button="Ban" data-confirm-tone="danger" data-confirm-icon="fa-tower-broadcast">
                                <select name="minutes" class="adm-select">
                                    <option value="60">1 hour</option>
                                    <option value="1440" selected>1 day</option>
                                    <option value="10080">7 days</option>
                                    <option value="0">Permanent</option>
                                </select>
                                <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="Why can they not go live?" required></textarea>
                                <button type="submit" class="adm-btn is-danger"><i class="fa-solid fa-tower-broadcast"></i> Ban from going live</button>
                            </form>
                        </details>
                    }

                    @if (Model.IsBanned)
                    {
                        <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Unban" asp-route-id="@Model.Id" class="adm-action-row" data-confirm="They can sign in and use the platform again." data-confirm-title="Unban this member?" data-confirm-button="Unban" data-confirm-tone="success" data-confirm-icon="fa-rotate-left">
                            <button type="submit" class="adm-btn is-success"><i class="fa-solid fa-rotate-left"></i> Unban member</button>
                        </form>
                    }
                    else
                    {
                        <details class="adm-action">
                            <summary><i class="fa-solid fa-ban"></i> Ban</summary>
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Ban" asp-route-id="@Model.Id" data-confirm="They are signed out right now and cannot sign in until the ban ends." data-confirm-title="Ban this member?" data-confirm-button="Ban member" data-confirm-tone="danger" data-confirm-icon="fa-ban">
                                <select name="days" class="adm-select">
                                    <option value="1">1 day</option>
                                    <option value="7">7 days</option>
                                    <option value="30">30 days</option>
                                    <option value="0" selected>Permanent</option>
                                </select>
                                <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="Why is this member being banned?" required></textarea>
                                <button type="submit" class="adm-btn is-danger"><i class="fa-solid fa-ban"></i> Ban member</button>
                            </form>
                        </details>
                    }
                }

                @if (Model.CanDelete)
                {
                    <div class="adm-danger-zone">
                        <h4>Delete account</h4>
                        <p>The account is removed for good: the profile is wiped and nobody can sign in with it. Their posts and messages stay, shown as "Deleted user". Only a SuperAdmin can do this.</p>
                        <details class="adm-action is-danger">
                            <summary><i class="fa-solid fa-trash"></i> Delete account</summary>
                            <form method="post" asp-area="Admin" asp-controller="Users" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="This cannot be undone." data-confirm-title="Delete this account?" data-confirm-button="Delete forever" data-confirm-tone="danger" data-confirm-icon="fa-trash">
                                <textarea name="reason" class="adm-textarea" maxlength="300" placeholder="Reason" required></textarea>
                                <input type="text" name="userName" class="adm-input" placeholder="Type @@@Model.UserName to confirm" autocomplete="off" required>
                                <button type="submit" class="adm-btn is-outline-danger"><i class="fa-solid fa-trash"></i> Delete account</button>
                            </form>
                        </details>
                    </div>
                }
            }
        </div>
    </div>
}
