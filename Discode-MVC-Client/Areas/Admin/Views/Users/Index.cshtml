@model AdminUserListVM
@{
    ViewData["Title"] = "Users";
    ViewData["Section"] = "users";
}
<div class="adm-list-head">
    <form method="get" class="adm-search" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="search" value="@Model.Search" placeholder="Search by username, name or email" autocomplete="off">
    </form>
    <span class="adm-count">@Model.Total users</span>
</div>

<div class="adm-table-wrap">
    <table class="adm-table">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Account</th>
                <th>Servers</th>
                <th>Bans</th>
                <th>Joined</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td>
                        <div class="adm-person">
                            <img src="@(string.IsNullOrWhiteSpace(user.AvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : user.AvatarUrl)" alt="">
                            <span><strong>@(string.IsNullOrWhiteSpace(user.DisplayName) ? user.UserName : user.DisplayName)</strong><small>@user.UserName</small></span>
                        </div>
                    </td>
                    <td class="adm-muted">@user.Email</td>
                    <td>
                        @foreach (var role in user.Roles)
                        {
                            <span class="adm-chip role-@role.ToLowerInvariant()">@role</span>
                        }
                    </td>
                    <td><span class="adm-chip @(user.IsPublic ? "is-public" : "is-private")">@(user.IsPublic ? "Public" : "Private")</span></td>
                    <td>@user.ServersJoined</td>
                    <td><span class="@(user.BansReceived > 0 ? "adm-bad" : "adm-muted")">@user.BansReceived</span></td>
                    <td class="adm-muted">@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="adm-empty">No users found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="adm-pager">
        <a class="@(Model.Page <= 1 ? "is-off" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)"><i class="fa-solid fa-chevron-left"></i></a>
        <span>Page @Model.Page / @Model.TotalPages</span>
        <a class="@(Model.Page >= Model.TotalPages ? "is-off" : "")" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)"><i class="fa-solid fa-chevron-right"></i></a>
    </div>
}
