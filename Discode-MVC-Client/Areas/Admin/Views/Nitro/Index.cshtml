@model AdminNitroListVM
@{
    ViewData["Title"] = "Nitro";
    ViewData["Section"] = "nitro";
    var isSuper = User.IsInRole("SuperAdmin");
    string Money(int? cents, string currency) => cents is null ? "" : (cents.Value / 100m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + " " + currency.ToUpperInvariant();
    string KindLabel(string kind) => System.Text.RegularExpressions.Regex.Replace(kind, "(?<=[a-z])(?=[A-Z])", " ");
    string KindClass(string kind) => kind switch
    {
        "PaymentFailed" or "Expired" or "RevokedByAdmin" or "GiftRevoked" => "is-banned",
        "Canceled" => "is-timeout",
        _ => ""
    };
}
@if (TempData["AdminNotice"] is string notice)
{
    <p class="adm-notice"><i class="fa-solid fa-circle-check"></i> @notice</p>
}
@if (TempData["AdminWarning"] is string warning)
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @warning</p>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <p class="adm-error"><i class="fa-solid fa-triangle-exclamation"></i> @Model.Error</p>
}

<div class="adm-stats">
    <div class="adm-stat"><span>Nitro right now</span><strong>@Model.ActiveCount</strong></div>
    <div class="adm-stat"><span>Money taken in all</span><strong>@Money((int)Model.RevenueCents, "usd")</strong></div>
    <div class="adm-stat"><span>Money taken this month</span><strong>@Money((int)Model.RevenueThisMonthCents, "usd")</strong></div>
</div>

<div class="adm-tabs">
    <a class="@(Model.Tab == "events" ? "on" : "")" asp-area="Admin" asp-controller="Nitro" asp-action="Index" asp-route-tab="events" asp-route-search="@Model.Search">Log <span>@Model.TotalEvents</span></a>
    <a class="@(Model.Tab == "members" ? "on" : "")" asp-area="Admin" asp-controller="Nitro" asp-action="Index" asp-route-tab="members" asp-route-search="@Model.Search">Members with Nitro <span>@Model.ActiveCount active</span></a>
    <a class="@(Model.Tab == "gifts" ? "on" : "")" asp-area="Admin" asp-controller="Nitro" asp-action="Index" asp-route-tab="gifts" asp-route-search="@Model.Search">Gifts <span>@Model.TotalGifts</span></a>
</div>

@if (isSuper)
{
    <div class="adm-panel">
        <h3>Give or take away Nitro</h3>
        <p class="adm-muted">Nitro given here does not use Stripe. Taking Nitro away from somebody who pays through Stripe also stops their subscription there.</p>
        <form method="post" class="adm-inline-form" asp-area="Admin" asp-controller="Nitro" asp-action="Grant">
            <input type="hidden" name="tab" value="@Model.Tab">
            <input type="text" name="userName" placeholder="User name" maxlength="64" autocomplete="off" required>
            <input type="number" name="days" value="30" min="1" max="3650" aria-label="Days" required>
            <button type="submit" class="adm-btn"><i class="fa-solid fa-gift"></i> Give Nitro</button>
        </form>
    </div>
    <div class="adm-panel">
        <h3>Make a free gift link</h3>
        <p class="adm-muted">Nobody pays for it. Whoever opens the link and presses Accept gets the days. You can take it back until it is claimed.</p>
        <form method="post" class="adm-inline-form" asp-area="Admin" asp-controller="Nitro" asp-action="MakeGift">
            <input type="number" name="days" value="30" min="1" max="3650" aria-label="Days" required>
            <button type="submit" class="adm-btn"><i class="fa-solid fa-link"></i> Make a gift link</button>
        </form>
    </div>
}

<div class="adm-list-head">
    <form method="get" class="adm-search" asp-area="Admin" asp-controller="Nitro" asp-action="Index">
        <input type="hidden" name="tab" value="@Model.Tab">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="search" name="search" value="@Model.Search" placeholder="Search by user name or name" autocomplete="off">
    </form>
    <span class="adm-count">@(Model.Tab == "members" ? Model.TotalSubscriptions + " subscribers" : Model.Tab == "gifts" ? Model.TotalGifts + " gifts" : Model.TotalEvents + " events")</span>
</div>

<div class="adm-table-wrap">
    @if (Model.Tab == "events")
    {
        <table class="adm-table">
            <thead>
                <tr><th>When</th><th>Member</th><th>What happened</th><th>Amount</th><th>Source</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Events)
                {
                    <tr>
                        <td class="adm-muted">@entry.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a class="adm-link" asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@entry.UserId">@(string.IsNullOrWhiteSpace(entry.DisplayName) ? entry.UserName : entry.DisplayName)</a><small class="adm-muted"> @@@entry.UserName</small></td>
                        <td><span class="adm-chip @KindClass(entry.Kind)">@KindLabel(entry.Kind)</span> <span class="adm-muted">@entry.Details</span>@if (!string.IsNullOrEmpty(entry.ActorName)) { <small class="adm-muted"> by @entry.ActorName</small> }</td>
                        <td>@Money(entry.AmountCents, entry.Currency)</td>
                        <td class="adm-muted">@(entry.Source == "admin" ? "Admin" : entry.Source == "gift" ? "Gift" : "Stripe")</td>
                    </tr>
                }
                @if (Model.Events.Count == 0)
                {
                    <tr><td colspan="5" class="adm-muted">Nothing has happened yet.</td></tr>
                }
            </tbody>
        </table>
    }
    else if (Model.Tab == "gifts")
    {
        <table class="adm-table">
            <thead>
                <tr><th>Link</th><th>From</th><th>Days</th><th>Paid</th><th>Status</th><th>Claimed by</th><th>Made</th>@if (isSuper) { <th></th> }</tr>
            </thead>
            <tbody>
                @foreach (var gift in Model.Gifts)
                {
                    <tr>
                        <td><code>@(gift.Code.Substring(0, 8))...</code> <small class="adm-muted"><a class="adm-link" href="@gift.Link">open</a></small></td>
                        <td>@gift.BuyerUserName</td>
                        <td>@gift.Days</td>
                        <td>@(gift.IsFree ? "Free" : Money(gift.AmountCents, "usd"))</td>
                        <td><span class="adm-chip @(gift.Status == "revoked" ? "is-banned" : gift.Status == "redeemed" ? "" : "is-timeout")">@(gift.Status == "available" ? "Not claimed" : gift.Status == "redeemed" ? "Claimed" : "Taken back")</span></td>
                        <td class="adm-muted">@gift.RedeemedByUserName</td>
                        <td class="adm-muted">@gift.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        @if (isSuper)
                        {
                            <td>
                                @if (gift.Status == "available")
                                {
                                    <form method="post" asp-area="Admin" asp-controller="Nitro" asp-action="RevokeGift">
                                        <input type="hidden" name="id" value="@gift.Id">
                                        <button type="submit" class="adm-btn adm-btn-danger">Take back</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (Model.Gifts.Count == 0)
                {
                    <tr><td colspan="@(isSuper ? 8 : 7)" class="adm-muted">No gifts yet.</td></tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <table class="adm-table">
            <thead>
                <tr><th>Member</th><th>Status</th><th>Source</th><th>Started</th><th>Runs until</th><th>Paid in all</th><th>Payments</th><th>Last payment</th><th>Boosts</th>@if (isSuper) { <th></th> }</tr>
            </thead>
            <tbody>
                @foreach (var sub in Model.Subscriptions)
                {
                    <tr>
                        <td>
                            <div class="adm-person">
                                <img src="@(string.IsNullOrWhiteSpace(sub.AvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : sub.AvatarUrl)" alt="">
                                <span><strong><a class="adm-link" asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@sub.UserId">@(string.IsNullOrWhiteSpace(sub.DisplayName) ? sub.UserName : sub.DisplayName)</a></strong><small>@sub.UserName</small></span>
                            </div>
                        </td>
                        <td>
                            <span class="adm-chip @(sub.IsActive ? "" : "is-banned")">@(sub.IsActive ? "Active" : "Ended")</span>
                            @if (sub.IsActive && sub.CancelAtPeriodEnd) { <span class="adm-chip is-timeout">Cancelled</span> }
                            @if (sub.IsActive && sub.Status == "PastDue") { <span class="adm-chip is-timeout">Payment late</span> }
                        </td>
                        <td class="adm-muted">@(sub.Source == "admin" ? "Admin" : sub.Source == "gift" ? "Gift" : "Stripe")</td>
                        <td class="adm-muted">@sub.StartedAt.ToString("yyyy-MM-dd")</td>
                        <td class="adm-muted">@sub.CurrentPeriodEnd.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(sub.TotalPaidCents > 0 ? Money((int)sub.TotalPaidCents, "usd") : "Free")</td>
                        <td>@sub.Payments</td>
                        <td class="adm-muted">@(sub.LastPaymentAt is null ? "" : sub.LastPaymentAt.Value.ToString("yyyy-MM-dd"))</td>
                        <td>@sub.Boosts</td>
                        @if (isSuper)
                        {
                            <td>
                                @if (sub.IsActive)
                                {
                                    <form method="post" asp-area="Admin" asp-controller="Nitro" asp-action="Revoke" onsubmit="return confirm('@(sub.Source == "stripe" ? "Cancel the Nitro of " + sub.UserName + "? Their Stripe subscription is stopped and they will not be charged again." : "Take the Nitro away from " + sub.UserName + "?")');">
                                        <input type="hidden" name="userName" value="@sub.UserName">
                                        <input type="hidden" name="tab" value="members">
                                        <button type="submit" class="adm-btn adm-btn-danger">Take away</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (Model.Subscriptions.Count == 0)
                {
                    <tr><td colspan="@(isSuper ? 10 : 9)" class="adm-muted">Nobody has Nitro yet.</td></tr>
                }
            </tbody>
        </table>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="adm-pager">
        @if (Model.Page > 1)
        {
            <a asp-area="Admin" asp-controller="Nitro" asp-action="Index" asp-route-tab="@Model.Tab" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)">Previous</a>
        }
        <span>Page @Model.Page of @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a asp-area="Admin" asp-controller="Nitro" asp-action="Index" asp-route-tab="@Model.Tab" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)">Next</a>
        }
    </div>
}
