@model AdminOverviewVM
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "overview";
}
<div class="stat-grid">
    <a class="stat-card" asp-area="Admin" asp-controller="Users" asp-action="Index">
        <div class="stat-head"><span>Users</span><i class="stat-icon tone-blue fa-solid fa-users"></i></div>
        <strong>@Model.Users.Total.ToString("N0")</strong>
        <small class="tone-green-text">+@Model.Users.NewLast7Days this week</small>
    </a>

    <a class="stat-card" asp-area="Admin" asp-controller="Servers" asp-action="Index">
        <div class="stat-head"><span>Servers</span><i class="stat-icon tone-green fa-solid fa-server"></i></div>
        <strong>@Model.Servers.Total.ToString("N0")</strong>
        <small>@Model.Servers.Public public &middot; @Model.Servers.Private private</small>
    </a>

    <div class="stat-card stat-staff" id="stat-staff" data-admins="@Model.Users.Admins" data-superadmins="@Model.Users.SuperAdmins"
         data-admins-url="@Url.Action("Index", "Users", new { area = "Admin", filter = "admins" })"
         data-superadmins-url="@Url.Action("Index", "Users", new { area = "Admin", filter = "superadmins" })">
        <div class="stat-head">
            <div class="adm-picker adm-picker-mini">
                <button type="button" class="adm-picker-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span id="stat-staff-label">Admins</span>
                    <i class="fa-solid fa-chevron-down adm-picker-arrow"></i>
                </button>
                <ul class="adm-picker-menu" role="listbox" hidden>
                    <li role="option"><a class="on" href="#" data-staff="admins"><span>Admins</span><i class="fa-solid fa-check"></i></a></li>
                    <li role="option"><a href="#" data-staff="superadmins"><span>SuperAdmins</span><i class="fa-solid fa-check"></i></a></li>
                </ul>
            </div>
            <i class="stat-icon tone-purple fa-solid fa-user-shield"></i>
        </div>
        <strong id="stat-staff-count">@Model.Users.Admins.ToString("N0")</strong>
    </div>

    <a class="stat-card" asp-area="Admin" asp-controller="Users" asp-action="Index" asp-route-filter="banned">
        <div class="stat-head"><span>Banned users</span><i class="stat-icon tone-red fa-solid fa-user-xmark"></i></div>
        <strong>@Model.Bans.UsersBanned.ToString("N0")</strong>
        <small>@Model.Bans.TotalBans server bans in total</small>
    </a>

    <a class="stat-card" asp-area="Admin" asp-controller="Servers" asp-action="Index" asp-route-filter="banned">
        <div class="stat-head"><span>Servers with bans</span><i class="stat-icon tone-amber fa-solid fa-ban"></i></div>
        <strong>@Model.Bans.ServersWithBans.ToString("N0")</strong>
        <small>Servers that banned someone</small>
    </a>

    <div class="stat-card">
        <div class="stat-head"><span>Reports</span><i class="stat-icon tone-red fa-solid fa-flag"></i></div>
        <strong>@Model.Reports.Total.ToString("N0")</strong>
        <small class="@(Model.Reports.Open > 0 ? "tone-red-text" : "")">@Model.Reports.Open waiting review</small>
    </div>
</div>
