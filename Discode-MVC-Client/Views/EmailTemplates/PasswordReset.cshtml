@model Discode_MVC_Client.ViewModels.Email.PasswordResetEmailUIVM
@{
    Layout = "_EmailLayout";
}
<tr>
    <td style="padding:0 0 16px;font-family:'Nunito Sans',Arial,Helvetica,sans-serif;font-size:40px;font-weight:700;line-height:1.1;color:#e7e9ea;">
        Reset your password
    </td>
</tr>
<tr>
    <td style="padding:0 0 28px;font-family:'Nunito Sans',Arial,Helvetica,sans-serif;font-size:17px;line-height:1.5;color:#71767b;">
        We received a request to reset your Discode password. Press the button below to choose a new one.
    </td>
</tr>
<tr>
    <td style="padding:0 0 28px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
            <tr>
                <td align="center" bgcolor="#ffffff" style="background:#ffffff;border-radius:9999px;">
                    <a href="@Model.ResetUrl" style="display:block;padding:11px 24px;font-family:'Nunito Sans',Arial,Helvetica,sans-serif;font-size:17px;font-weight:700;color:#0f1419;text-decoration:none;">Reset password</a>
                </td>
            </tr>
        </table>
    </td>
</tr>
<tr>
    <td style="padding:0 0 12px;font-family:'Nunito Sans',Arial,Helvetica,sans-serif;font-size:15px;line-height:1.5;color:#71767b;">
        This link expires in 1 hour. If you did not request it, you can ignore this email.
    </td>
</tr>
<tr>
    <td style="font-family:'Nunito Sans',Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:#71767b;word-break:break-all;">
        Button not working? Open this link: <a href="@Model.ResetUrl" style="color:#1d9bf0;text-decoration:none;">@Model.ResetUrl</a>
    </td>
</tr>
