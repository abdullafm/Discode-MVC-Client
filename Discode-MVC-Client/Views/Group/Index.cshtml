@model GroupPageVM
@{
    Layout = "_HomeLayout";
    var group = Model.Group;
    var groupJson = group is null ? "" : System.Text.Json.JsonSerializer.Serialize(group, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
}
<main class="friends-view group-view show-main">
    @if (group is null)
    {
        <section id="group-chat">
            <div class="group-chat">
                <div class="group-scroll">
                    <div class="group-intro">
                        <span class="group-badge"><i class="fa-solid fa-user-group"></i></span>
                        <h2>Group not found</h2>
                        <p>@Model.Error</p>
                        <div class="group-actions">
                            <button type="button" onclick="window.discodeGo('/Home/Index')"><i class="fa-solid fa-arrow-left"></i> Back to Friends</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section id="group-chat" data-group-id="@group.Id" data-me="@Model.Profile.UserName" data-group="@groupJson"><div class="group-chat">
            <div class="group-bar">
                <div class="group-bar-name">
                    <span class="group-mark" id="group-mark"><i class="fa-solid fa-user-group"></i><img alt="" hidden></span>
                    <h1 id="group-title">@group.Name</h1>
                </div>
                <div class="group-bar-tools">
                    <button type="button" id="group-members-toggle" class="on" aria-label="Members"><i class="fa-solid fa-user-group"></i></button>
                    <button type="button" id="group-call-voice" aria-label="Start voice call"><i class="fa-solid fa-phone"></i></button>
                    <button type="button" id="group-call-video" aria-label="Start video call"><i class="fa-solid fa-video"></i></button>
                    <button type="button" id="group-add" aria-label="Invite"><i class="fa-solid fa-user-plus"></i></button>
                    <label class="group-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" id="group-search" placeholder="Search" aria-label="Search">
                    </label>
                </div>
            </div>
            <div class="call-stage gcall-stage" id="group-call-stage" hidden>
                <div class="gcall-faces" id="gcall-faces"></div>
                <div class="call-bar">
                    <div class="call-pill">
                        <button type="button" class="call-btn" id="gcall-mic" aria-label="Mute" aria-pressed="false"><i class="fa-solid fa-microphone"></i></button>
                        <button type="button" class="call-btn" id="gcall-deafen" aria-label="Deafen" aria-pressed="false"><i class="fa-solid fa-headphones"></i></button>
                        <button type="button" class="call-btn is-off" id="gcall-cam" aria-label="Turn on camera" aria-pressed="true"><i class="fa-solid fa-video-slash"></i></button>
                        <span class="call-line"></span>
                        <button type="button" class="call-btn" id="gcall-screen" aria-label="Share your screen" aria-pressed="false"><i class="fa-solid fa-display"></i></button>
                    </div>
                    <button type="button" class="call-hangup" id="gcall-hangup" aria-label="Disconnect"><i class="fa-solid fa-phone"></i></button>
                </div>
            </div>
            <div class="gcall-banner" id="group-call-banner" hidden>
                <i class="fa-solid fa-phone"></i>
                <span id="group-call-banner-text"></span>
                <button type="button" id="group-call-banner-join">Join Call</button>
            </div>
            <div class="group-scroll" id="group-scroll">
                <div class="group-intro">
                    <span class="group-badge" id="group-badge"><i class="fa-solid fa-user-group"></i><img alt="" hidden></span>
                    <h2 id="group-name">@group.Name</h2>
                    <p id="group-welcome">Welcome to the beginning of the @group.Name group.</p>
                    <div class="group-actions" id="group-actions">
                        <button type="button" id="group-invite"><i class="fa-solid fa-user-plus"></i> Invite to Group DM</button>
                        <button type="button" id="group-edit"><i class="fa-solid fa-pen"></i> Edit Group</button>
                    </div>
                </div>
                <div class="dm-messages group-messages" id="group-messages"></div>
            </div>
            <p class="group-error" id="group-error" hidden></p>
            <div class="dm-reply-bar" id="group-reply-bar" hidden>
                <span>Replying to <strong id="group-reply-name"></strong></span>
                <button type="button" id="group-reply-cancel" aria-label="Cancel reply"><i class="fa-solid fa-circle-xmark"></i></button>
            </div>
            <form class="dm-compose" id="group-compose">
                <button type="button" id="group-attach" aria-label="Add"><i class="fa-solid fa-plus"></i></button>
                <input type="file" id="group-file" multiple hidden>
                <div class="dm-attach-menu" id="group-attach-menu" role="menu" hidden>
                    <button type="button" role="menuitem" data-act="upload"><i class="fa-solid fa-file-arrow-up"></i><span>Upload a File</span></button>
                    <button type="button" role="menuitem" data-act="poll"><i class="fa-solid fa-square-poll-horizontal"></i><span>Create Poll</span></button>
                </div>
                <div class="dm-input-wrap">
                    <span class="dm-placeholder" id="group-placeholder" aria-hidden="true">Message @group.Name</span>
                    <div class="rich-text" id="group-input" contenteditable="true" role="textbox" aria-label="Message" data-placeholder="Message @group.Name" data-empty="1"></div>
                </div>
                <div class="dm-compose-tools">
                    <button type="button" id="group-emoji" aria-label="Emoji"><i class="fa-regular fa-face-smile"></i></button>
                </div>
                <div class="emoji-panel" id="emoji-panel" hidden></div>
            </form>
        </div></section>
        <section id="group-members"><div class="group-members">
            <h2>Members — <span id="group-count">@group.MemberCount</span></h2>
            <div id="group-member-list"></div>
            <button type="button" id="group-invite-side"><i class="fa-solid fa-user-plus"></i> Invite to Group DM</button>
            <button type="button" id="group-leave" class="group-leave"><i class="fa-solid fa-right-from-bracket"></i> Leave Group</button>
        </div></section>
    }
</main>
@if (group is not null)
{
    <div class="group-edit-modal" id="group-edit-modal" hidden>
        <form class="group-edit-card" id="group-rename">
            <div class="group-edit-head">
                <h2>Edit Group</h2>
                <button type="button" id="group-rename-cancel" aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <label class="group-edit-icon" id="group-edit-icon">
                <i class="fa-solid fa-user-group"></i>
                <img alt="" hidden>
                <span><i class="fa-solid fa-pen"></i></span>
                <input type="file" id="group-icon-file" accept="image/*">
            </label>
            <input type="text" id="group-name-input" maxlength="80">
            <p class="group-edit-error" id="group-edit-error" hidden></p>
            <div class="group-edit-actions">
                <button type="button" id="group-edit-cancel">Cancel</button>
                <button type="submit">Save</button>
            </div>
        </form>
    </div>
}
@if (group is not null)
{
    <div class="dm-modal" id="group-confirm-modal" role="dialog" aria-modal="true" aria-labelledby="group-confirm-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="group-confirm-title"></h2>
            <p class="dm-modal-text" id="group-confirm-text"></p>
            <div class="dm-modal-actions">
                <button type="button" class="dm-modal-cancel" data-close>Cancel</button>
                <button type="button" class="dm-modal-confirm is-danger" id="group-confirm-ok"></button>
            </div>
        </div>
    </div>
}
@if (group is not null)
{
    <div class="dm-modal" id="group-poll-modal" role="dialog" aria-modal="true" aria-labelledby="group-poll-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card dm-poll-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="group-poll-title">Create a Poll</h2>
            <label class="dm-poll-label" for="group-poll-question">Question</label>
            <input type="text" id="group-poll-question" class="dm-poll-input" maxlength="300" placeholder="What question do you want to ask?" autocomplete="off">
            <div class="dm-poll-count"><span id="group-poll-count">0</span> / 300</div>
            <div class="dm-poll-label">Answers</div>
            <div class="dm-poll-answers" id="group-poll-answers"></div>
            <button type="button" class="dm-poll-add" id="group-poll-add"><i class="fa-solid fa-plus"></i> Add another answer</button>
            <label class="dm-poll-label" for="group-poll-duration">Duration</label>
            <select id="group-poll-duration" class="dm-poll-input dm-poll-select">
                <option value="1">1 hour</option>
                <option value="4">4 hours</option>
                <option value="8">8 hours</option>
                <option value="24" selected>24 hours</option>
                <option value="72">3 days</option>
                <option value="168">1 week</option>
                <option value="336">2 weeks</option>
            </select>
            <p class="dm-poll-error" id="group-poll-error" hidden></p>
            <div class="dm-poll-foot">
                <label class="dm-poll-multi"><input type="checkbox" id="group-poll-multiple"><span>Allow Multiple Answers</span></label>
                <button type="button" class="dm-poll-post" id="group-poll-post">Post</button>
            </div>
            <div class="dm-poll-emojis" id="group-poll-emojis" hidden></div>
        </div>
    </div>
}
@if (group is not null)
{
    <div class="dm-msg-menu" id="group-msg-menu" role="menu" hidden>
        <div class="dm-menu-quick">
            <button type="button" class="dm-react" data-act="react" aria-label="React with heart">&#10084;&#65039;</button>
        </div>
        <button type="button" role="menuitem" class="emoji-open" data-menu="reaction"><i class="fa-solid fa-face-smile"></i><span>Add Reaction</span><i class="fa-solid fa-chevron-right dm-menu-arrow"></i></button>
        <hr>
        <button type="button" role="menuitem" data-menu="reply"><i class="fa-solid fa-reply"></i><span>Reply</span></button>
        <button type="button" role="menuitem" data-menu="forward"><i class="fa-solid fa-share"></i><span>Forward</span></button>
        <hr>
        <button type="button" role="menuitem" data-menu="copy-text"><i class="fa-solid fa-copy"></i><span>Copy Text</span></button>
        <hr data-own-only>
        <button type="button" role="menuitem" class="is-danger" data-menu="delete" data-own-only><i class="fa-solid fa-trash-can"></i><span>Delete Message</span></button>
    </div>
    <div class="dm-modal" id="group-forward-modal" role="dialog" aria-modal="true" aria-labelledby="group-forward-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card dm-forward-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="group-forward-title">Forward To</h2>
            <p class="dm-modal-text">Select where you want to share this message.</p>
            <label class="dm-forward-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" id="group-forward-search" placeholder="Search" aria-label="Search" autocomplete="off">
            </label>
            <div class="dm-forward-list" id="group-forward-list"></div>
            <div class="dm-forward-foot">
                <div class="dm-forward-preview" id="group-forward-preview"></div>
                <p class="dm-forward-error" id="group-forward-error" hidden></p>
                <div class="dm-forward-send">
                    <input type="text" id="group-forward-note" maxlength="2000" placeholder="Add an optional message..." aria-label="Optional message" autocomplete="off">
                    <button type="button" id="group-forward-submit" disabled>Send <i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script src="~/assets/js/groupparts.js" asp-append-version="true"></script>
    <script src="~/assets/js/groupchat.js" asp-append-version="true"></script>
}
