@model HomeUIVM
@{
    Layout = "_ServerLayout";
}
<main class="friends-view server-view">
    <section id="server-chat" data-me="@Model.Profile.UserName">
        <div class="server-room">
            <div class="server-bar">
                <button type="button" class="server-back" onclick="openToggle()" aria-label="Channels">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h1><span id="server-room-mark">#</span> <span id="server-room-name"></span></h1>
                <div class="server-bar-tools">
                    <button type="button" aria-label="Notification Settings">
                        <i class="fa-solid fa-bell"></i>
                    </button>
                    <button type="button" aria-label="Pinned Messages">
                        <i class="fa-solid fa-thumbtack"></i>
                    </button>
                    <button type="button" class="server-members-toggle on" id="server-members-toggle" aria-label="Members">
                        <i class="fa-solid fa-user"></i>
                    </button>
                </div>
            </div>
            <template id="server-message-row">
                <div class="server-message">
                    <img alt="">
                    <div>
                        <strong></strong><time></time>
                        <p></p>
                    </div>
                </div>
            </template>
            <template id="server-voice-people">
                <div class="server-voice-people" hidden></div>
            </template>
            <template id="server-voice-user">
                <div class="server-voice-user"><img alt=""><span></span><span class="voice-user-icons"><i class="fa-solid fa-microphone-slash voice-mute-icon" aria-hidden="true"></i><span class="voice-deaf-icon"><i class="fa-solid fa-headphones" aria-hidden="true"></i></span></span></div>
            </template>
            <div class="group-scroll server-chat-scroll" id="group-scroll" hidden>
                <div class="group-intro server-chat-intro">
                    <span class="group-badge"><i class="fa-solid fa-hashtag" id="server-chat-badge"></i></span>
                    <h2 id="server-chat-title">Welcome to #general!</h2>
                    <p id="server-chat-welcome">This is the start of the #general channel.</p>
                </div>
                <div class="dm-messages group-messages" id="group-messages"></div>
            </div>
            <p class="group-error" id="group-error" hidden></p>
            <div class="dm-reply-bar" id="group-reply-bar" hidden>
                <span>Replying to <strong id="group-reply-name"></strong></span>
                <button type="button" id="group-reply-cancel" aria-label="Cancel reply"><i class="fa-solid fa-circle-xmark"></i></button>
            </div>
            <p class="server-announce-lock server-chat-lock" id="server-chat-lock" hidden>You do not have permission to send messages in this channel.</p>
            <form class="dm-compose" id="group-compose" hidden>
                <button type="button" id="group-attach" aria-label="Add"><i class="fa-solid fa-plus"></i></button>
                <input type="file" id="group-file" multiple hidden>
                <div class="dm-attach-menu" id="group-attach-menu" role="menu" hidden>
                    <button type="button" role="menuitem" data-act="upload"><i class="fa-solid fa-file-arrow-up"></i><span>Upload a File</span></button>
                    <button type="button" role="menuitem" data-act="poll" hidden><i class="fa-solid fa-square-poll-horizontal"></i><span>Create Poll</span></button>
                </div>
                <div class="dm-input-wrap">
                    <span class="dm-placeholder" id="group-placeholder" aria-hidden="true">Message</span>
                    <div class="rich-text" id="group-input" contenteditable="true" role="textbox" aria-label="Message" data-placeholder="Message" data-empty="1"></div>
                </div>
                <div class="dm-compose-tools">
                    <button type="button" id="group-emoji" aria-label="Emoji"><i class="fa-regular fa-face-smile"></i></button>
                </div>
                <div class="emoji-panel" id="emoji-panel" hidden></div>
            </form>
            <div class="server-messages" id="server-messages" hidden>
                <div class="server-welcome" id="server-welcome" hidden>
                    <span class="server-welcome-mark" aria-hidden="true">#</span>
                    <h2 id="server-welcome-title">Welcome to #general!</h2>
                    <p id="server-welcome-text">This is the start of the #general channel.</p>
                    <button type="button" id="server-welcome-edit">
                        <i class="fa-solid fa-pen"></i> Edit
                        Channel
                    </button>
                </div>
                <div id="server-message-list"></div>
            </div>
            <div class="server-room-empty" id="server-chat-empty">
                <div class="server-room-empty-copy">
                    <h3 id="server-chat-empty-title">Select a channel.</h3>
                    <p id="server-chat-empty-text" hidden></p>
                </div>
            </div>
            <form class="server-compose" id="server-compose" hidden>
                <p class="server-announce-lock" id="server-announce-lock" hidden>
                    You do not have permission to send
                    messages in this channel.
                </p>
                <button type="button" class="server-compose-add" aria-label="Add">
                    <i class="fa-solid fa-plus"></i>
                </button>
                <div class="rich-text" id="server-input" contenteditable="true" role="textbox" aria-label="Message"
                     data-placeholder="Message" data-empty="1"></div>
                <div class="server-compose-tools">
                    <button type="button" aria-label="Emoji"><i class="fa-regular fa-face-smile"></i></button>
                </div>
            </form>
        </div>
    </section>
    <section id="server-voice" hidden>
        <div class="server-room server-voice">
            <div class="server-bar">
                <button type="button" class="server-back" onclick="openToggle()" aria-label="Channels">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h1><i class="fa-solid fa-volume-high"></i> <span id="server-voice-name"></span></h1>
                <div class="server-bar-tools">
                    <button type="button" class="server-members-toggle on" aria-label="Members">
                        <i class="fa-solid fa-user"></i>
                    </button>
                </div>
            </div>
            <div class="server-voice-stage" id="server-voice-lobby">
                <i class="fa-solid fa-volume-high"></i>
                <p id="server-voice-status">Voice room</p>
                <div class="server-voice-actions">
                    <button type="button" id="server-voice-join">Join</button>
                    <button type="button" id="server-voice-leave" hidden>Leave</button>
                </div>
            </div>
            <div class="server-voice-call" id="server-voice-call" hidden>
                <div class="server-voice-tile" id="server-voice-tile">
                    <video id="server-voice-screen-video" class="server-voice-screen" autoplay playsinline
                           muted></video>
                    <video id="server-voice-cam-video" class="server-voice-cam-video" autoplay playsinline
                           muted></video>
                    <img id="server-voice-face" src="~/assets/img/img-icon-profile.jpeg" alt="">
                    <p id="server-voice-person" class="me-display">Anonymou5</p>
                </div>
            </div>
            <div class="server-voice-dock" id="server-voice-dock" hidden>
                <div class="server-voice-dock-main">
                    <div class="server-voice-dock-group">
                        <button type="button" id="server-voice-mic" aria-label="Mute">
                            <i class="fa-solid fa-microphone"></i>
                        </button>
                        <button type="button" id="server-voice-cam" aria-label="Camera">
                            <i class="fa-solid fa-video"></i>
                        </button>
                        <span class="call-line"></span>
                        <button type="button" id="server-voice-screen" aria-label="Share your screen"
                                aria-pressed="false">
                            <i class="fa-solid fa-display"></i>
                        </button>
                    </div>
                    <button type="button" id="server-voice-hangup" aria-label="Disconnect">
                        <i class="fa-solid fa-phone"></i>
                    </button>
                </div>
                <div class="server-voice-dock-side">
                    <button type="button" id="server-voice-full" aria-label="Full Screen" aria-pressed="false"><i class="fa-solid fa-expand"></i></button>
                </div>
            </div>
        </div>
    </section>
    <section id="server-settings" hidden>
        <div class="server-settings">
            <aside class="server-settings-nav">
                <p class="server-settings-kicker" id="server-settings-name">Server</p>
                <button type="button" class="on" data-panel="profile">Server Profile</button>
                <button type="button" data-panel="boost">Boost Perks</button>
                <p>People</p>
                <button type="button" data-panel="members">Members</button>
                <button type="button" data-panel="roles">Roles</button>
                <p>Moderation</p>
                <button type="button" data-panel="audit">Audit Log</button>
                <button type="button" data-panel="bans">Bans</button>
                <button type="button" class="server-settings-delete" id="server-delete-open">
                    <span>
                        Delete
                        Server
                    </span><i class="fa-solid fa-trash"></i>
                </button>
            </aside>
            <button type="button" class="server-settings-close" id="server-settings-close" aria-label="Close">
                <i class="fa-solid fa-xmark"></i><span>ESC</span>
            </button>
            <div class="server-settings-main">
                <section id="server-settings-panel-1" data-panel="profile">
                    <div class="server-settings-panel">
                        <div class="server-profile-layout">
                            <form class="server-profile-form" id="server-profile-form">
                                <h2>Server Profile</h2>
                                <p class="server-profile-lead">
                                    Customize how your server appears in invite links
                                    and, if enabled, in Server Discovery and Announcement Channel messages.
                                </p>
                                <label for="server-profile-name">Name</label>
                                <input id="server-profile-name" type="text" maxlength="100"
                                       placeholder="Server Name">
                                <label for="server-icon-file">Icon</label>
                                <p class="server-profile-hint">We recommend an image of at least 512x512.</p>
                                <div class="server-icon-row">
                                    <span class="server-icon-face" id="server-icon-face">
                                        <img alt=""
                                             hidden><span>S</span>
                                    </span>
                                    <label class="server-icon-btn">
                                        <input id="server-icon-file" type="file"
                                               accept="image/*">Change Server Icon
                                    </label>
                                </div>
                                <label>Banner</label>
                                <div class="server-banner-colors" id="server-banner-colors">
                                    <button type="button" class="on" data-color="ink" aria-label="Black"></button>
                                    <button type="button" data-color="pink" aria-label="Pink"></button>
                                    <button type="button" data-color="red" aria-label="Red"></button>
                                    <button type="button" data-color="orange" aria-label="Orange"></button>
                                    <button type="button" data-color="yellow" aria-label="Yellow"></button>
                                    <button type="button" data-color="purple" aria-label="Purple"></button>
                                    <button type="button" data-color="blue" aria-label="Blue"></button>
                                    <button type="button" data-color="cyan" aria-label="Cyan"></button>
                                    <button type="button" data-color="green" aria-label="Green"></button>
                                    <button type="button" data-color="gray" aria-label="Gray"></button>
                                </div>
                                <label for="server-profile-about">Description</label>
                                <textarea id="server-profile-about" maxlength="300"
                                          placeholder="Tell the world a bit about this server."></textarea>
                                <div class="server-private">
                                    <div>
                                        <strong>Private Profile</strong>
                                        <p>
                                            When enabled, only server members can view profile content. Non-members
                                            won't be able to see this content unless they have an invite.
                                        </p>
                                    </div>
                                    <input id="server-private" type="checkbox" role="switch"
                                           aria-label="Private Profile">
                                </div>
                                <div class="server-save-bar" id="server-save-bar" hidden>
                                    <span id="server-save-note">Careful — you have unsaved changes!</span>
                                    <button type="button" class="server-save-reset" id="server-save-reset">Reset</button>
                                    <button type="submit" class="server-save-go" id="server-save-go">Save Changes</button>
                                </div>
                            </form>
                            <aside class="server-profile-side">
                                <div class="server-preview" id="server-profile-preview" data-banner="ink">
                                    <div class="server-preview-banner"></div>
                                    <span class="server-preview-icon" id="server-preview-icon">
                                        <img alt=""
                                             hidden><span>S</span>
                                    </span>
                                    <h3 id="server-preview-name">Server</h3>
                                    <p class="server-preview-meta"><span></span></p>
                                    <p class="server-preview-since"><span></span></p>
                                </div>
                                <div class="server-private-card">
                                    <span>?</span>
                                    <strong>Private Server</strong>
                                    <p>This server has invited who can see this profile.</p>
                                </div>
                            </aside>
                        </div>
                    </div>
                </section>
                <section id="server-settings-panel-2" data-panel="boost" hidden>
                    <div class="server-settings-panel">
                        <div class="boost-layout">
                            <div class="boost-head">
                                <div>
                                    <h2>Boost Perks</h2>
                                </div>
                            </div>
                            <div class="boost-perk">
                                <div>
                                    <h3>Server Banner Background</h3>
                                    <p>This image will display at the top of your channels list.</p>
                                    <p class="server-profile-hint">
                                        The recommended minimum size is 960x540 and
                                        recommended aspect ratio is 16:9.
                                    </p>
                                </div>
                                <div class="boost-drop-col">
                                    <label class="boost-drop">
                                        <input id="boost-banner-file" type="file" accept="image/*">
                                        <img id="boost-banner-preview" alt="" hidden>
                                        <i class="fa-regular fa-image"></i>
                                    </label>
                                    <button type="button" class="boost-drop-remove" id="boost-banner-remove" hidden>Remove banner</button>
                                    <p class="boost-note" id="boost-banner-note"></p>
                                </div>
                            </div>
                            <div class="boost-perk">
                                <div>
                                    <h3>Custom Invite Link</h3>
                                    <p>
                                        Bring others to your server easily with your own customized invite link.
                                        Heads up though, anyone with the link can join and you'll need at least one
                                        text channel that is open to all server members.
                                    </p>
                                    <label for="boost-invite-link">Invite link</label>
                                    <div class="boost-invite-row">
                                        <input id="boost-invite-link" type="text" maxlength="32"
                                               placeholder="your-link" autocomplete="off" spellcheck="false">
                                        <button type="button" class="boost-invite-save" id="boost-invite-save" disabled>Save Link</button>
                                    </div>
                                    <p class="boost-note" id="boost-invite-note"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section id="server-settings-panel-3" data-panel="members" hidden>
                    <div class="server-settings-panel members-panel">
                        <h2>Server Members</h2>
                        <div class="members-switch">
                            <div>
                                <strong>Show Members In Channel List</strong>
                                <p>
                                    Enabling this will show the members page in the channel list, allowing you to
                                    quickly see who's recently joined your server, and find any users flagged for
                                    unusual activity.
                                </p>
                            </div>
                            <input id="members-in-list" type="checkbox" role="switch"
                                   aria-label="Show Members In Channel List" checked>
                        </div>
                        <div class="members-bar">
                            <h3 id="members-title">Recent Members</h3>
                            <label class="members-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input id="members-search-input" type="search" placeholder="Search by username or id"
                                       aria-label="Search by username or id">
                            </label>
                            <button type="button" class="members-sort" id="members-sort">
                                <i class="fa-solid fa-arrow-down-wide-short"></i> Sort
                            </button>
                            <button type="button" class="members-prune">Prune</button>
                        </div>
                        <div class="members-table-wrap">
                            <table class="members-table">
                                <thead>
                                    <tr>
                                        <th>
                                            <input id="members-select-all" type="checkbox" aria-label="Select all">
                                        </th>
                                        <th data-sort="name">Name</th>
                                        <th data-sort="since">Member Since <i class="fa-solid fa-arrow-down-wide-short"></i></th>
                                        <th data-sort="discord">Joined Discord <i class="fa-solid fa-arrow-down-wide-short"></i></th>
                                        <th data-sort="method">Join Method <i class="fa-solid fa-arrow-down-wide-short"></i></th>
                                        <th data-sort="roles">Roles <i class="fa-solid fa-arrow-down-wide-short"></i></th>
                                        <th>Signals</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="server-member-table"></tbody>
                            </table>
                            <p class="members-empty"><i class="fa-solid fa-magnifying-glass"></i><span>No members yet.</span></p>
                        </div>
                        <p class="members-count" id="members-count"></p>
                    </div>
                </section>
                <section id="server-settings-panel-4" data-panel="roles" hidden>
                    <div class="server-settings-panel role-editor">
                        <aside class="role-side">
                            <div class="role-side-bar">
                                <button type="button" id="role-back">
                                    <i class="fa-solid fa-arrow-left"></i><span>Back</span>
                                </button>
                                <button type="button" id="role-create" aria-label="Create Role">
                                    <i class="fa-solid fa-plus"></i>
                                </button>
                            </div>
                            <div class="role-list" id="server-role-list">
                                <button type="button" class="role-row" id="role-draft" hidden>
                                    <span class="role-dot"></span>
                                    <span class="role-label">new role</span>
                                </button>
                                <button type="button" class="role-row on" id="role-everyone">
                                    <span class="role-dot"></span>
                                    <span class="role-label">@@everyone</span>
                                </button>
                            </div>
                        </aside>
                        <div class="role-main">
                            <div class="role-head">
                                <h2>Edit Role — <span id="role-editor-name">@@everyone</span></h2>
                                <button type="button" id="role-more" aria-expanded="false"
                                        aria-controls="role-more-menu" aria-label="Role options">
                                    <i class="fa-solid fa-ellipsis"></i>
                                </button>
                                <div class="role-more-menu" id="role-more-menu" hidden>
                                    <button type="button">
                                        <i class="fa-solid fa-clone"></i><span>
                                        Duplicate
                                        Role
                                    </span>
                                </button>
                                <button type="button">
                                    <i class="fa-solid fa-arrow-right"></i><span>
                                    View Server
                                    As Role
                                </span>
                            </button>
                            <hr>
                            <button type="button" id="role-delete" disabled>
                                <i class="fa-solid fa-trash"></i><span>Delete</span>
                            </button>
                        </div>
                    </div>
                    <div class="role-tabs">
                        <button type="button" data-role-tab="display">Display</button>
                        <button type="button" data-role-tab="permissions">Permissions</button>
                        <button type="button" class="on" data-role-tab="members">
                            Manage Members (<span id="role-member-count">0</span>)
                        </button>
                    </div>
                    <div class="role-panel" data-role-panel="display" hidden>
                        <label for="role-name">Role Name</label>
                        <input id="role-name" type="text" maxlength="100" value="@@everyone" readonly>
                        <label>Role Color</label>
                        <div class="role-colors" id="role-colors">
                            <button type="button" class="on" data-role-color="gray"
                                    aria-label="Gray"></button>
                            <button type="button" data-role-color="pink" aria-label="Pink"></button>
                            <button type="button" data-role-color="red" aria-label="Red"></button>
                            <button type="button" data-role-color="orange" aria-label="Orange"></button>
                            <button type="button" data-role-color="yellow" aria-label="Yellow"></button>
                            <button type="button" data-role-color="purple" aria-label="Purple"></button>
                            <button type="button" data-role-color="blue" aria-label="Blue"></button>
                            <button type="button" data-role-color="green" aria-label="Green"></button>
                        </div>
                        <label class="role-separate">
                            <input id="role-separate" type="checkbox">
                            <span>Display role members separately from online members</span>
                        </label>
                    </div>
                    <div class="role-panel" data-role-panel="permissions" hidden>
                        <section id="perm-group-1">
                            <div class="perm-group">
                                <div class="perm-head">
                                    <h3>General Server Permissions</h3>
                                    <button type="button" class="perm-clear">Clear permissions</button>
                                </div>
                                <label class="perm-row">
                                    <span class="perm-copy">
                                        <strong>View Channels</strong><small>
                                        Allows
                                        members to view channels by default (excluding private
                                        channels).
                                    </small>
                                </span>
                                <span class="perm-switch">
                                    <input type="checkbox" role="switch"
                                           aria-label="View Channels">
                                </span>
                            </label>
                            <label class="perm-row">
                                <span class="perm-copy">
                                    <strong>Manage Channels</strong><small>
                                    Allows
                                    members to create, edit, or delete channels.
                                </small>
                            </span>
                            <span class="perm-switch">
                                <input type="checkbox" role="switch"
                                       aria-label="Manage Channels">
                            </span>
                        </label>
                        <label class="perm-row">
                            <span class="perm-copy">
                                <strong>Manage Roles</strong><small>
                                Allows
                                members to create new roles and edit or delete roles lower than
                                their highest role. Also allows members to change permissions of
                                individual channels that they have access to.
                            </small>
                        </span>
                        <span class="perm-switch">
                            <input type="checkbox" role="switch"
                                   aria-label="Manage Roles">
                        </span>
                    </label>
                    <label class="perm-row">
                        <span class="perm-copy">
                            <strong>Create Expressions</strong><small>
                            Allows
                            members to add custom emoji, stickers, and sounds in this
                            server.
                        </small>
                    </span>
                    <span class="perm-switch">
                        <input type="checkbox" role="switch"
                               aria-label="Create Expressions">
                    </span>
                </label>
                <label class="perm-row">
                    <span class="perm-copy">
                        <strong>Manage Expressions</strong><small>
                        Allows
                        members to edit or remove custom emoji, stickers, and sounds in
                        this server.
                    </small>
                </span>
                <span class="perm-switch">
                    <input type="checkbox" role="switch"
                           aria-label="Manage Expressions">
                </span>
            </label>
            <label class="perm-row">
                <span class="perm-copy">
                    <strong>View Audit Log</strong><small>
                    Allows
                    members to view a record of who made which changes in this
                    server.
                </small>
            </span>
            <span class="perm-switch">
                <input type="checkbox" role="switch"
                       aria-label="View Audit Log">
            </span>
        </label>
        <label class="perm-row">
            <span class="perm-copy">
                <strong>Manage Webhooks</strong><small>
                Allows
                members to create, edit, or delete webhooks, which can post
                messages from other apps or sites into this
                server.
            </small>
        </span>
        <span class="perm-switch">
            <input type="checkbox" role="switch"
                   aria-label="Manage Webhooks">
        </span>
    </label>
    <label class="perm-row">
        <span class="perm-copy">
            <strong>Manage Server</strong><small>
            Allows
            members to change this server's name, icon, banner, and other
            settings.
        </small>
    </span>
    <span class="perm-switch">
        <input type="checkbox" role="switch"
               aria-label="Manage Server">
    </span>
</label>
<label class="perm-row">
    <span class="perm-copy">
        <strong>Kick Members</strong><small>
        Allows members to remove other members from this server. Kicked members can rejoin with an invite.
    </small>
</span>
<span class="perm-switch">
    <input type="checkbox" role="switch"
           aria-label="Kick Members">
</span>
</label>
<label class="perm-row">
    <span class="perm-copy">
        <strong>Ban Members</strong><small>
        Allows members to permanently ban other members from this server and to lift those bans.
    </small>
</span>
<span class="perm-switch">
    <input type="checkbox" role="switch"
           aria-label="Ban Members">
</span>
</label>
<label class="perm-row">
    <span class="perm-copy">
        <strong>Timeout Members</strong><small>
        When you put a member in timeout they can't send messages or react. They can still read the channels.
    </small>
