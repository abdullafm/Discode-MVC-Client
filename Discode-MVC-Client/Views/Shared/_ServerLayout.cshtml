<!DOCTYPE html>
<html lang="en">

<head>
    <script src="~/assets/js/theme.js"></script>
    <script src="~/assets/js/i18n.js"></script>
    <script src="~/assets/js/nav.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discord | Server</title>
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/server.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="shortcut icon" href="~/assets/icons/favicon.ico" type="image/x-icon">
</head>

<body>
    <header class="app-header">
        <div class="server-rail" id="server-rail">
            <nav class="server-nav" aria-label="Servers">
                <button type="button" class="server-home" onclick="openToggle()" aria-label="Home">
                    <i class="fa-brands fa-discord" aria-hidden="true"></i>
                </button>
                <hr>
                <a href="@Url.Action("Index", "Server")?id=azaan" data-id="azaan" aria-label="Azaan server">
                    <img src="~/assets/img/Azaan.jpeg" alt="">
                </a>
                <div id="server-list"></div>
                <template id="server-chip"><button type="button" class="server-chip"></button></template>
                <button type="button" class="server-action" id="server-add" aria-label="Add a Server">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </button>
                <hr>
                <a class="server-action" href="./discover.html" aria-label="Discover"><i class="fa-solid fa-compass"></i></a>
                <a class="server-action" href="./discover.html" aria-label="Discover"><i class="fa-solid fa-server"></i></a>
            </nav>
        </div>
        <aside class="conversation-sidebar server-channels" id="conversations">
            <div class="server-banner-wrap" data-can-manage>
                <button type="button" class="server-banner" id="server-menu-open" aria-expanded="false"
                        aria-controls="server-menu">
                    <span id="server-title">Azaan</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="server-menu" id="server-menu" hidden>
                    <button type="button"><i class="fa-solid fa-gem"></i><span>Server Boost</span></button>
                    <button type="button" data-invite="server">
                        <i class="fa-solid fa-user-plus"></i><span>
                        Invite to
                        Server
                    </span>
                </button>
                <button type="button" id="server-settings-open">
                    <i class="fa-solid fa-gear"></i><span>
                    Server
                    Settings
                </span>
            </button>
            <button type="button" data-create="channel">
                <i class="fa-solid fa-hashtag"></i><span>
                Create
                Channel
            </span>
        </button>
        <button type="button" data-create="category">
            <i class="fa-solid fa-folder-plus"></i><span>
            Create
            Category
        </span>
    </button>
    <hr class="server-menu-divider" id="server-leave-sep">
    <button type="button" class="server-menu-item server-menu-leave is-danger" id="server-leave-open">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Leave Server</span>
    </button>
</div>
</div>
<div class="server-channel-scroll" id="server-channel-scroll">
    <nav id="server-channel-list" aria-label="Channels">
        <div class="server-channel-loose" id="server-channel-loose"></div>
        <div class="server-category">
            <div class="server-category-head">
                <button type="button" class="server-category-name">
                    <i class="fa-solid fa-chevron-down"></i>
                    <span>Text Channels</span>
                </button>
                <button type="button" class="server-category-add" data-create="channel"
                        aria-label="Create Channel">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            <div class="server-category-list">
                <div class="server-channel-row">
                    <button type="button" class="server-channel on" data-kind="text" data-send="1">
                        <i class="fa-solid fa-hashtag"></i>
                        <span class="server-channel-name">general</span>
                        <i class="fa-solid fa-lock server-channel-lock" hidden aria-hidden="true"></i>
                    </button>
                    <button type="button" class="server-channel-edit" data-edit-channel
                            aria-label="Edit Channel">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>
                <div class="server-channel-row">
                    <button type="button" class="server-channel" data-kind="announce" data-send="0">
                        <i class="fa-solid fa-bullhorn"></i>
                        <span class="server-channel-name">announcements</span>
                        <i class="fa-solid fa-lock server-channel-lock" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="server-channel-edit" data-edit-channel
                            aria-label="Edit Channel">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="server-category">
            <div class="server-category-head">
                <button type="button" class="server-category-name">
                    <i class="fa-solid fa-chevron-down"></i>
                    <span>Voice Channels</span>
                </button>
                <button type="button" class="server-category-add" data-create="channel"
                        aria-label="Create Channel">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            <div class="server-category-list">
                <div class="server-channel-row">
                    <button type="button" class="server-channel" data-kind="voice" data-join="1">
                        <i class="fa-solid fa-volume-high"></i>
                        <span class="server-channel-name">Lounge</span>
                        <span class="server-voice-live" hidden>0:00</span>
                        <i class="fa-solid fa-lock server-channel-lock" hidden aria-hidden="true"></i>
                    </button>
                    <button type="button" class="server-channel-edit" data-edit-channel
                            aria-label="Edit Channel">
                        <i class="fa-solid fa-gear"></i>
                    </button>
                </div>
                <div class="server-voice-people" hidden>
                    <div class="server-voice-user">
                        <img src="~/assets/img/img-icon-profile.jpeg" alt="">
                        <span>
                            <strong class="me-display">Anonymou5</strong><small>
                            Set a channel
                            status
                        </small>
                    </span>
                    <span class="voice-user-icons">
                        <i class="fa-solid fa-microphone-slash voice-mute-icon" aria-hidden="true"></i>
                        <span class="voice-deaf-icon"><i class="fa-solid fa-headphones" aria-hidden="true"></i></span>
                    </span>
                </div>
                <div class="server-voice-invite">
                    <button type="button" class="server-voice-invite-open">
                        <i class="fa-solid fa-user-plus"></i><span>Invite to Voice</span>
                    </button>
                    <button type="button" class="server-voice-invite-close" aria-label="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <template id="server-category-new">
        <div class="server-category">
            <div class="server-category-head">
                <button type="button" class="server-category-name">
                    <i class="fa-solid fa-chevron-down"></i>
                    <span></span>
                </button>
                <button type="button" class="server-category-add" data-create="channel"
                        aria-label="Create Channel">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
            <div class="server-category-list"></div>
        </div>
    </template>
    <template id="server-channel-new">
        <div class="server-channel-row">
            <button type="button" class="server-channel" data-kind="text"
                    data-send="1">
                <i class="fa-solid fa-hashtag"></i><span class="server-channel-name"></span><span class="server-voice-live"
                                                                                                  hidden>0:00</span><i class="fa-solid fa-lock server-channel-lock" hidden
                                     aria-hidden="true"></i>
            </button><button type="button" class="server-channel-edit"
                         data-edit-channel aria-label="Edit Channel">
            <i class="fa-solid fa-gear"></i>
        </button>
    </div>
    <div class="server-voice-people" hidden>
        <div class="server-voice-user">
            <img src="~/assets/img/img-icon-profile.jpeg"
                 alt=""><span>
            <strong class="me-display">Anonymou5</strong><small>
            Set a channel
            status
        </small>
    </span><span class="voice-user-icons"><i class="fa-solid fa-microphone-slash voice-mute-icon" aria-hidden="true"></i><span class="voice-deaf-icon"><i class="fa-solid fa-headphones" aria-hidden="true"></i></span></span>
</div>
<div class="server-voice-invite">
    <button type="button"
            class="server-voice-invite-open">
        <i class="fa-solid fa-user-plus"></i><span>Invite to Voice</span>
    </button><button type="button" class="server-voice-invite-close" aria-label="Close">
    <i class="fa-solid fa-xmark"></i>
</button>
</div>
</div>
</template>
</nav>
<p class="server-channel-empty" id="server-channel-empty">No channels yet.</p>
</div>
<div class="channel-menu" id="channel-menu" hidden>
    <label>Hide Muted Channels<input type="checkbox" aria-label="Hide Muted Channels"></label>
    <hr>
    <button type="button" data-create="channel">Create Channel</button>
    <button type="button" data-create="category">Create Category</button>
    <button type="button" data-invite="server">Invite to Server</button>
</div>
<div class="channel-menu" id="channel-row-menu" hidden>
    <button type="button" data-action="edit">Edit Channel</button>
    <button type="button" data-action="delete" class="is-danger">Delete Channel</button>
</div>
<div class="server-voice-bar" id="server-voice-bar" hidden>
    <div>
        <strong><i class="fa-solid fa-signal"></i> Voice Connected</strong>
        <span id="server-voice-bar-where">Lounge / Azaan</span>
    </div>
    <button type="button" id="server-voice-bar-leave" aria-label="Disconnect">
        <i class="fa-solid fa-phone-slash"></i>
    </button>
</div>
<div class="user-panel" id="user-panel">
    <div class="user-identity">
        <div class="avatar">
            <img src="~/assets/img/img-icon-profile.jpeg" alt="">
        </div>
        <div class="user-details">
            <p class="me-display">Anonymou5</p>
            <span>Online</span>
        </div>
    </div>
    <div class="user-controls">
        <button type="button" onclick="mic()" aria-label="Mute microphone"><i class="fa-solid fa-microphone" id="mic" aria-hidden="true"></i></button>
        <button type="button" id="headp-btn" onclick="headp()" aria-label="Deafen">
            <i class="fa-solid fa-headphones"
               id="head" aria-hidden="true"></i>
        </button>
        <button type="button" id="settings-open" aria-label="Settings">
            <i class="fa-solid fa-gear"></i>
        </button>
    </div>
</div>
</aside>
</header>
        @RenderBody()
 <footer>

        <div class="channel-modal" id="channel-modal" hidden>
            <form class="channel-card" id="channel-form">
                <div class="channel-card-head">
                    <div>
                        <h2>Create Channel</h2>
                        <p class="channel-where" id="channel-where" hidden>in <span id="channel-where-name"></span></p>
                    </div>
                    <button type="button" id="channel-modal-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <p class="channel-kicker">Channel Type</p>
                <div class="channel-types" id="channel-types">
                    <label class="channel-type">
                        <input type="radio" name="channel-kind" value="text" checked>
                        <span class="channel-type-mark"></span>
                        <i class="fa-solid fa-hashtag"></i>
                        <span><strong>Text</strong><small>Send messages, images, GIFs, emoji, opinions, and
                                puns</small></span>
                    </label>
                    <label class="channel-type">
                        <input type="radio" name="channel-kind" value="voice">
                        <span class="channel-type-mark"></span>
                        <i class="fa-solid fa-volume-high"></i>
                        <span><strong>Voice</strong><small>Hang out together with voice, video, and screen
                                share</small></span>
                    </label>
                </div>
                <label class="channel-kicker" for="channel-name">Channel Name</label>
                <div class="channel-name">
                    <i class="fa-solid fa-hashtag" id="channel-name-icon"></i>
                    <input id="channel-name" type="text" value="new-channel" maxlength="100" autocomplete="off">
                    <i class="fa-solid fa-circle-check" id="channel-name-ok"></i>
                </div>
                <label class="channel-kicker" id="channel-category-label" for="channel-category-pick" hidden>Category</label>
                <div class="channel-name" id="channel-category-wrap" hidden>
                    <i class="fa-solid fa-folder"></i>
                    <select id="channel-category-pick"></select>
                </div>
                <div class="channel-private">
                    <i class="fa-solid fa-lock"></i>
                    <span><strong>Private Channel</strong><small>Only selected members and roles will be able to view
                            this channel.</small></span>
                    <span class="perm-switch"><input type="checkbox" id="channel-private" role="switch"
                            aria-label="Private Channel"></span>
                </div>
                <div class="channel-actions">
                    <button type="button" id="channel-modal-cancel">Cancel</button>
                    <button type="submit" id="channel-modal-confirm">Create Channel</button>
                </div>
            </form>
        </div>
        <div class="channel-modal" id="channel-edit" hidden>
            <form class="channel-card" id="channel-edit-form">
                <div class="channel-card-head">
                    <div>
                        <h2 id="channel-edit-title">Edit Channel</h2>
                        <p class="channel-where" id="channel-edit-sub"></p>
                    </div>
                    <button type="button" id="channel-edit-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <label class="channel-kicker" for="channel-edit-name">Channel Name</label>
                <div class="channel-name">
                    <i class="fa-solid fa-hashtag" id="channel-edit-icon"></i>
                    <input id="channel-edit-name" type="text" maxlength="100" autocomplete="off">
                </div>
                <div class="perm-group channel-edit-perms">
                    <div class="perm-head">
                        <h3>Permissions</h3>
                    </div>
                    <label class="perm-row" data-perm="view">
                        <span class="perm-copy"><strong>View Channel</strong><small>Allows members to see this
                                channel.</small></span>
                        <span class="perm-switch"><input id="channel-perm-view" type="checkbox" role="switch"
                                aria-label="View Channel"></span>
                    </label>
                    <label class="perm-row" data-perm="send">
                        <span class="perm-copy"><strong>Send Messages</strong><small>Allows members to send messages in
                                this channel.</small></span>
                        <span class="perm-switch"><input id="channel-perm-send" type="checkbox" role="switch"
                                aria-label="Send Messages"></span>
                    </label>
                    <label class="perm-row" data-perm="manage">
                        <span class="perm-copy"><strong>Manage Messages</strong><small>Allows members to delete or pin
                                messages by other members.</small></span>
                        <span class="perm-switch"><input id="channel-perm-manage" type="checkbox" role="switch"
                                aria-label="Manage Messages"></span>
                    </label>
                    <label class="perm-row" data-perm="connect">
                        <span class="perm-copy"><strong>Connect</strong><small>Allows members to join this voice
                                channel.</small></span>
                        <span class="perm-switch"><input id="channel-perm-connect" type="checkbox" role="switch"
                                aria-label="Connect"></span>
                    </label>
                    <label class="perm-row" data-perm="speak">
                        <span class="perm-copy"><strong>Speak</strong><small>Allows members to talk in this voice
                                channel.</small></span>
                        <span class="perm-switch"><input id="channel-perm-speak" type="checkbox" role="switch"
                                aria-label="Speak"></span>
                    </label>
                </div>
                <div class="channel-actions">
                    <button type="button" id="channel-edit-cancel">Cancel</button>
                    <button type="submit" id="channel-edit-save">Save Changes</button>
                </div>
            </form>
        </div>
        <div class="channel-modal invite-modal" id="invite-modal" hidden>
            <div class="channel-card invite-card" role="dialog" aria-labelledby="invite-title">
                <div class="channel-card-head">
                    <h2 id="invite-title">Invite friends to <span id="invite-server-name">Server</span></h2>
                    <button type="button" id="invite-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <p class="invite-lead">Recipients will land in <span id="invite-room">the server</span></p>
                <label class="invite-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search" placeholder="Search for friends" aria-label="Search for friends">
                </label>
                <div class="invite-list" id="invite-list">
                    <div class="invite-row" data-friend="Mr_Sigma">
                        <img src="~/assets/img/img-icon 4.jpeg" alt="">
                        <span><strong>Mr_Sigma</strong><small>mr_sigma</small></span>
                        <button type="button" class="invite-send">Invite</button>
                    </div>
                    <div class="invite-row" data-friend="Gpro-fighter">
                        <img src="~/assets/img/img-icon 3.png" alt="">
                        <span><strong>Gpro-fighter</strong><small>gpro-fighter</small></span>
                        <button type="button" class="invite-send">Invite</button>
                    </div>
                    <div class="invite-row" data-friend="Moiz Hussain">
                        <img src="~/assets/img/img-icon 2.png" alt="">
                        <span><strong>Moiz Hussain</strong><small>moiz-hussain</small></span>
                        <button type="button" class="invite-send">Invite</button>
                    </div>
                    <div class="invite-row" data-friend="nxn">
                        <img src="~/assets/img/img-icon 1.png" alt="">
                        <span><strong>nxn</strong><small>nxn</small></span>
                        <button type="button" class="invite-send">Invite</button>
                    </div>
                    <div class="invite-row" data-friend="Unknown_Inj3ctor">
                        <img src="~/assets/img/img-icon.png" alt="">
                        <span><strong>Unknown_Inj3ctor</strong><small>unknown_inj3ctor</small></span>
                        <button type="button" class="invite-send">Invite</button>
                    </div>
                </div>
                <div class="invite-link-block">
                    <p>Or, send a server invite link to a friend</p>
                    <div class="invite-link-row">
                        <input id="invite-link" type="text" readonly placeholder="Invite link">
                        <button type="button" id="invite-copy">Copy</button>
                    </div>
                    <p class="invite-note">Your invite link expires in 30 days. <button type="button"
                            class="invite-edit">Edit invite link.</button></p>
                </div>
            </div>
        </div>
        <div class="channel-modal" id="category-modal" hidden>
            <form class="channel-card" id="category-form">
                <div class="channel-card-head">
                    <h2 id="category-modal-title">Create Category</h2>
                    <button type="button" id="category-modal-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <label class="channel-kicker" for="category-name">Category Name</label>
                <div class="channel-name">
                    <input id="category-name" type="text" value="New Category" maxlength="100" autocomplete="off">
                    <button type="button" class="category-emoji" aria-label="Emoji"><i
                            class="fa-regular fa-face-smile"></i></button>
                </div>
                <div class="channel-private">
                    <span><strong>Private Category</strong><small>By making a category private, only select members and
                            roles will be able to view this category. Linked channels in this category will
                            automatically match to this setting.</small></span>
                    <span class="perm-switch"><input type="checkbox" id="category-private" role="switch"
                            aria-label="Private Category"></span>
                </div>
                <div class="channel-actions">
                    <button type="button" id="category-modal-cancel">Cancel</button>
                    <button type="submit" id="category-modal-confirm">Create Category</button>
                </div>
            </form>
        </div>
        <div class="server-delete-modal" id="server-delete-modal" hidden>
            <form class="server-delete-card" id="server-delete-form">
                <div class="server-delete-head">
                    <h2>Delete '<span id="server-delete-title">Server</span>'</h2>
                    <button type="button" id="server-delete-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <p>Are you sure you want to delete <strong id="server-delete-name">Server</strong>? This action cannot
                    be undone.</p>
                <label for="server-delete-input">Enter server name</label>
                <input id="server-delete-input" type="text" autocomplete="off">
                <div class="server-delete-actions">
                    <button type="button" id="server-delete-cancel">Cancel</button>
                    <button type="submit" id="server-delete-confirm" disabled>Delete Server</button>
                </div>
            </form>
        </div>
        <div class="server-delete-modal" id="remove-modal" hidden>
            <form class="server-delete-card" id="remove-form">
                <div class="server-delete-head">
                    <h2 id="remove-title">Delete Channel</h2>
                    <button type="button" id="remove-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <p>Are you sure you want to delete <strong id="remove-name">Channel</strong>? This cannot be undone.</p>
                <p id="remove-note" hidden>Channels inside this category will also be deleted.</p>
                <div class="server-delete-actions">
                    <button type="button" id="remove-cancel">Cancel</button>
                    <button type="submit" id="remove-confirm">Delete Channel</button>
                </div>
            </form>
        </div>
        <div class="server-delete-modal leave-server-modal" id="leave-server-modal" hidden>
            <div class="server-delete-card leave-server-card" role="dialog" aria-labelledby="leave-server-title">
                <div class="server-delete-head">
                    <h2>Leave '<span id="leave-server-title">Server</span>'</h2>
                    <button type="button" id="leave-server-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <p>Are you sure you want to leave <strong id="leave-server-name">Server</strong>? You won’t be able to re-join this server unless you are re-invited.</p>
                <div class="server-delete-actions leave-server-actions">
                    <button type="button" id="leave-server-cancel">Cancel</button>
                    <button type="button" id="leave-server-confirm" class="leave-server-confirm-btn">Leave Server</button>
                </div>
            </div>
        </div>
        <div class="group-edit-modal" id="group-edit-modal" hidden>
            <form class="group-edit-card" id="group-rename">
                <div class="group-edit-head">
                    <h2>Edit Group</h2>
                    <button type="button" id="group-rename-cancel" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <label class="group-edit-icon" id="group-edit-icon">
                    <i class="fa-solid fa-user-group"></i>
                    <span><i class="fa-solid fa-pen"></i></span>
                    <input type="file" id="group-icon-file" accept="image/*">
                </label>
                <input type="text" id="group-name-input" maxlength="80">
                <div class="group-edit-actions">
                    <button type="button" id="group-edit-cancel">Cancel</button>
                    <button type="submit">Save</button>
                </div>
            </form>
        </div>
        <div class="new-msg" id="new-msg" hidden>
            <div class="new-msg-card" role="dialog" aria-labelledby="new-msg-title">
                <div class="new-msg-head">
                    <div>
                        <h2 id="new-msg-title">New Message</h2>
                        <p>Group DMs can have up to 10 members.</p>
                    </div>
                    <button type="button" class="new-msg-close" id="new-msg-close" aria-label="Close"><i
                            class="fa-solid fa-xmark"></i></button>
                </div>
                <label class="new-msg-search">
                    <span id="new-msg-chips"></span>
                    <input id="new-msg-search" type="text" placeholder="Search">
