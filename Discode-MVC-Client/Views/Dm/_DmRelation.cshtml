@model DmRelationVM
@{
    var returnUrl = Url.Action("Index", "Dm", new { name = Model.UserName });
}
<i hidden data-relation="@Model.Relation"></i>
@if (Model.Relation == "friend" && Model.FriendRequestId is not null)
{
    <form asp-controller="Friend" asp-action="Remove" method="post" class="dm-meta-form">
        <input type="hidden" name="id" value="@Model.FriendRequestId">
        <input type="hidden" name="returnUrl" value="@returnUrl">
        <button type="submit">Remove Friend</button>
    </form>
}
else if (Model.Relation == "none")
{
    <form asp-controller="Friend" asp-action="Send" method="post" class="dm-meta-form">
        <input type="hidden" name="userName" value="@Model.UserName">
        <input type="hidden" name="returnUrl" value="@returnUrl">
        <button type="submit">Add Friend</button>
    </form>
}
else if (Model.Relation == "pending-sent")
{
    <button type="button" class="dm-meta-pending" disabled><i class="fa-regular fa-clock"></i> Pending</button>
}
else if (Model.Relation == "pending-received" && Model.FriendRequestId is not null)
{
    <form asp-controller="Friend" asp-action="Accept" method="post" class="dm-meta-form">
        <input type="hidden" name="id" value="@Model.FriendRequestId">
        <input type="hidden" name="returnUrl" value="@returnUrl">
        <button type="submit">Accept Friend Request</button>
    </form>
}
<form asp-controller="Friend" asp-action="Block" method="post" class="dm-meta-form">
    <input type="hidden" name="userName" value="@Model.UserName">
    <button type="submit">Block</button>
</form>
