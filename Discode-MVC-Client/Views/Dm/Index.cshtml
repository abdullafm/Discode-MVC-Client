@using System.Globalization
@using Discode_MVC_Client.Mappers
@model DmPageUIVM
@{
    Layout = "_HomeLayout";
    var chat = Model.Chat;
    var shownName = chat is null ? (Model.Name.Length > 0 ? Model.Name : "Direct Messages") : (string.IsNullOrWhiteSpace(chat.DisplayName) ? chat.UserName : chat.DisplayName);
    var avatar = chat is null || string.IsNullOrWhiteSpace(chat.AvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : chat.AvatarUrl;
    var culture = CultureInfo.InvariantCulture;
    DateTime Local(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).AddMinutes(Model.UtcOffsetMinutes);
    long Millis(DateTime utc) => new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)).ToUnixTimeMilliseconds();
    var status = chat is not null && chat.Status != "online" ? " " + chat.Status : "";
    var pollJson = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}
<main class="friends-view dm-view show-main">
    <section id="dm-chat" data-user-name="@chat?.UserName" data-user-id="@chat?.UserId" data-ongoing-call="@chat?.OngoingCallMessageId">
        <div class="dm-chat">
            <div class="dm-bar">
                <div class="dm-bar-name">
                    <i class="fa-solid fa-at"></i>
                    <h1 id="dm-title">@shownName</h1>
                </div>
                <div class="dm-bar-tools">
                    <i class="fa-solid fa-phone" id="dm-call" role="button" tabindex="0" aria-label="Start a call"></i>
                    <i class="fa-solid fa-video" id="dm-video" role="button" tabindex="0" aria-label="Start a video call"></i>
                    <i class="fa-solid fa-thumbtack" id="dm-pins-toggle" role="button" tabindex="0" aria-label="Pinned Messages"></i>
                    <i class="fa-solid fa-user-plus" id="dm-add" role="button" tabindex="0" aria-label="Create a group DM"></i>
                    <button type="button" id="dm-profile-toggle" class="on" aria-label="Profile"><i class="fa-solid fa-user"></i></button>
                    <label class="dm-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search" placeholder="Search" aria-label="Search">
                    </label>
                </div>
            </div>
            <button type="button" class="call-return"><i class="fa-solid fa-phone"></i><span>Return to call</span></button>
            <div class="call-stage" id="call-stage" hidden>
                <div class="call-phone-bar">
                    <button type="button" class="call-phone-back" aria-label="Back"><i class="fa-solid fa-chevron-down"></i></button>
                    <p class="call-phone-name"></p>
                    <!-- <button type="button" class="call-phone-sound" aria-label="Speaker"><i class="fa-solid fa-volume-high"></i></button> -->
                </div>
                <video id="call-screen-video" class="call-screen-video" autoplay playsinline muted hidden></video>
                <video id="call-cam-video" class="call-cam-video" autoplay playsinline muted hidden></video>
                <div class="call-person">
                    <div class="call-faces" id="call-faces">
                        <div class="call-face">
                            <img id="call-avatar" alt="">
                            <span class="call-mute" id="call-mute"><i class="fa-solid fa-microphone-slash"></i><i class="fa-solid fa-headphones deaf-icon"></i></span>
                            <video class="call-tile-video" autoplay playsinline muted></video>
                            <div class="call-tile-loading" hidden><span></span><span></span><span></span></div>
                            <div class="call-tile-error" hidden>
                                <strong>Failed to start camera</strong>
                                <small></small>
                                <button type="button" class="call-tile-retry">Try again</button>
                            </div>
                            <div class="call-tile-name"><i class="fa-solid fa-microphone-slash" hidden></i><i class="fa-solid fa-headphones tile-deaf" hidden></i><span></span></div>
                        </div>
                        <div class="call-face is-peer" id="call-peer-face">
                            <img id="call-peer-avatar" alt="">
                            <span class="call-mute is-gone" id="call-peer-mute"><i class="fa-solid fa-microphone-slash"></i><i class="fa-solid fa-headphones deaf-icon"></i></span>
                            <video class="call-tile-video" autoplay playsinline muted></video>
                            <div class="call-tile-name"><i class="fa-solid fa-microphone-slash" hidden></i><i class="fa-solid fa-headphones tile-deaf" hidden></i><span></span></div>
                        </div>
                    </div>
                    <p class="call-phone-label"></p>
                </div>
                <div class="call-phone-sheet">
                    <div class="call-phone-faces"></div>
                    <div class="call-phone-add-card" id="call-phone-add-card">
                        <button type="button" class="call-phone-add">
                            <i class="fa-solid fa-user-plus"></i>
                            <span><b>Add people to Voice Chat</b><small>Let the group know you are here!</small></span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        <button type="button" class="call-phone-add-close" id="call-phone-add-close" aria-label="Close voice chat invite card">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
                <div class="call-answer-bar" id="call-answer-bar" hidden>
                    <button type="button" class="call-answer-btn is-accept" id="call-answer-video" aria-label="Join with video"><i class="fa-solid fa-video"></i></button>
                    <button type="button" class="call-answer-btn is-accept" id="call-answer-voice" aria-label="Join with voice"><i class="fa-solid fa-phone"></i></button>
                    <button type="button" class="call-answer-btn is-decline" id="call-answer-decline" aria-label="Decline"><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="call-bar">
                    <div class="call-pill">
                        <button type="button" class="call-btn is-off" id="call-mic" aria-label="Mute" aria-pressed="true"><i class="fa-solid fa-microphone-slash"></i></button>
                        <button type="button" class="call-btn" id="call-deafen" aria-label="Deafen" aria-pressed="false"><i class="fa-solid fa-headphones"></i></button>
                        <button type="button" class="call-btn is-off" id="call-cam" aria-label="Turn off camera" aria-pressed="true"><i class="fa-solid fa-video-slash"></i></button>
                        <span class="call-line"></span>
                        <button type="button" class="call-btn" id="call-screen" aria-label="Share your screen" aria-pressed="false"><i class="fa-solid fa-display"></i></button>
                    </div>
                    <button type="button" class="call-hangup" id="call-hangup" aria-label="Disconnect"><i class="fa-solid fa-phone"></i></button>
                </div>
            </div>
            <div class="call-resize" id="call-resize" role="separator" aria-orientation="horizontal" aria-label="Resize call" tabindex="0"></div>
            <div class="dm-scroll">
                <div class="dm-intro">
                    <img id="dm-avatar" src="@avatar" alt="">
                    <h2 id="dm-name">@(chat is null ? "" : shownName)</h2>
                    <p class="dm-handle" id="dm-handle">@chat?.UserName</p>
                    @if (chat is not null)
                    {
                        <p class="dm-start" id="dm-start">This is the beginning of your direct message history with <strong id="dm-start-name">@shownName</strong>.</p>
                    }
                    else if (Model.Error.Length > 0)
                    {
                        <p class="dm-start" id="dm-start">@Model.Error</p>
                    }
                    else
                    {
                        <p class="dm-start" id="dm-start">Pick a friend from your friends list to start a conversation.</p>
                    }
                    <div class="dm-meta">
                        <span>No servers in common</span>
                        <div id="dm-relation" class="dm-meta-forms">
                            @if (chat is not null)
                            {
                                <partial name="_DmRelation" model="new DmRelationUIVM { UserName = chat.UserName, Relation = chat.Relation, FriendRequestId = chat.FriendRequestId, BlockId = chat.BlockId }" />
                            }
                        </div>
                    </div>
                </div>
                <div class="dm-wave" id="dm-wave-box" hidden="@(chat is null || chat.Messages.Count > 0)">
                    <span class="dm-hand" aria-hidden="true">&#128075;</span>
                    <button type="button" id="dm-wave">Wave to @shownName</button>
                </div>
                <div class="dm-messages" id="dm-messages">
                    @if (chat is not null)
                    {
                        MessageUIVM? previous = null;
                        foreach (var message in chat.Messages)
                        {
                            var sentAt = Local(message.CreatedAt);
                            var newDay = previous is null || Local(previous.CreatedAt).Date != sentAt.Date;
                            var compact = !newDay && message.ReplyTo is null && !previous!.IsCall && previous!.SenderUserName == message.SenderUserName && (message.CreatedAt - previous.CreatedAt).TotalMinutes < 5;
                            if (newDay)
                            {
                                <div class="dm-divider"><span>@sentAt.ToString("MMMM d, yyyy", culture)</span></div>
                            }
                            if (message.IsCall)
                            {
                                <div class="dm-msg dm-call-msg@(message.CallMissedForMe ? " is-missed" : "")" data-id="@message.Id" data-public-id="@message.PublicId" data-sender="@message.SenderUserName" data-time="@Millis(message.CreatedAt)" data-mine="@(message.Mine ? "1" : "0")" data-pinned="0">
                                    <i class="fa-solid fa-phone"></i>
                                    <span class="dm-call-text">@if (message.CallMissedForMe){<text>You missed a call from <strong>@message.CallName</strong>.</text>}else{<strong>@message.CallName</strong><text>@message.CallTail</text>}</span>
                                    <time>@sentAt.ToString("h:mm tt", culture)</time>
                                </div>
                                previous = message;
                                continue;
                            }
                            <div class="dm-msg@(compact ? " compact" : "")@(message.ReplyTo is null ? "" : " has-reply")@(message.Undelivered ? " is-undelivered" : "")@(message.IsPoll ? " is-poll" : "")" data-id="@message.Id" data-public-id="@message.PublicId" data-sender="@message.SenderUserName" data-time="@Millis(message.CreatedAt)" data-mine="@(message.Mine ? "1" : "0")" data-pinned="@(message.PinnedAt is null ? "0" : "1")">
                                @if (message.ReplyTo is not null)
                                {
                                    <div class="dm-msg-reply" data-reply-id="@message.ReplyTo.MessageId" role="button" tabindex="0">
                                        <img class="dm-reply-avatar" alt="" src="@(string.IsNullOrWhiteSpace(message.ReplyTo.SenderAvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : message.ReplyTo.SenderAvatarUrl)">
                                        <strong>@(string.IsNullOrWhiteSpace(message.ReplyTo.SenderDisplayName) ? message.ReplyTo.SenderUserName : message.ReplyTo.SenderDisplayName)</strong>
                                        <span class="dm-reply-text">@message.ReplyTo.Text</span>
                                    </div>
                                }
                                <img class="dm-msg-avatar" alt="" src="@(string.IsNullOrWhiteSpace(message.SenderAvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : message.SenderAvatarUrl)">
                                <div class="dm-msg-body">
                                    <div class="dm-msg-head">
                                        <strong>@(string.IsNullOrWhiteSpace(message.SenderDisplayName) ? message.SenderUserName : message.SenderDisplayName)</strong>
                                        <time>@sentAt.ToString("h:mm tt", culture)</time>
                                    </div>
                                    @if (message.Forwarded)
                                    {
                                        <div class="dm-msg-forwarded"><i class="fa-solid fa-share"></i> Forwarded</div>
                                    }
                                    @if (message.StoryId is not null && !string.IsNullOrWhiteSpace(message.StoryImageUrl))
                                    {
                                        <a class="dm-story-reply" href="@Url.Action("Index", "Social", new { story = message.StoryId })" data-story-id="@message.StoryId"><img src="@message.StoryImageUrl" alt=""><span><i class="fa-solid fa-clapperboard"></i> @(message.Mine ? "You replied to a story" : "Replied to your story")</span></a>
                                    }
                                    @if (message.LiveStreamId is not null)
                                    {
                                        <a class="dm-live-card" href="@Url.Action("Index", "Social", new { live = message.LiveStreamId })">
                                            <span class="dm-live-thumb">@if (!string.IsNullOrWhiteSpace(message.LiveImageUrl)){<img src="@message.LiveImageUrl" alt="">}else{<i class="fa-solid fa-tower-broadcast"></i>}<em>LIVE</em></span>
                                            <span class="dm-live-info"><small>@(message.Mine ? "You shared a live stream" : "Shared a live stream with you")</small><strong>@message.LiveTitle</strong><span>@message.LiveHostName</span></span>
                                            <span class="dm-live-watch">Watch</span>
                                        </a>
                                    }
                                    <div class="dm-msg-text">@message.Text@if (message.EditedAt is not null){<span class="dm-msg-edited">(edited)</span>}</div>
                                    @if (message.IsPoll && message.Poll is not null)
                                    {
                                        <div class="dm-poll" data-poll="@System.Text.Json.JsonSerializer.Serialize(message.Poll, pollJson)"></div>
                                    }
                                    @if (message.Attachments.Count > 0)
                                    {
                                        <div class="dm-attachments">
                                            @foreach (var attachment in message.Attachments)
                                            {
                                                if (attachment.IsImage)
                                                {
                                                    <a class="dm-att-media" href="@attachment.Url" target="_blank" rel="noopener" data-att="image"><img src="@attachment.Url" alt="@attachment.FileName" loading="lazy"></a>
                                                }
                                                else if (attachment.IsVideo)
                                                {
                                                    <video class="dm-att-video" src="@attachment.Url" controls preload="metadata"></video>
                                                }
                                                else if (attachment.IsAudio)
                                                {
                                                    <div class="dm-att-audio"><span>@attachment.FileName</span><audio src="@attachment.Url" controls preload="metadata"></audio></div>
                                                }
                                                else
                                                {
                                                    <a class="dm-att-file" href="@attachment.Url" download="@attachment.FileName" target="_blank" rel="noopener"><i class="fa-solid fa-file-lines"></i><span class="dm-att-info"><strong>@attachment.FileName</strong><small>@attachment.SizeText</small></span><i class="fa-solid fa-download"></i></a>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (message.Undelivered)
                                    {
                                        <div class="dm-msg-undelivered"><i class="fa-solid fa-circle-exclamation"></i> Your message could not be delivered.</div>
                                    }
                                    @if (message.Reactions.Count > 0)
                                    {
                                        <div class="dm-reactions">
                                            @foreach (var reaction in message.Reactions)
                                            {
                                                <button type="button" class="dm-reaction@(reaction.Reacted ? " mine" : "")" data-emoji="@reaction.Emoji" aria-pressed="@(reaction.Reacted ? "true" : "false")"><span class="dm-reaction-emoji">@reaction.Emoji</span><span class="dm-reaction-count">@reaction.Count</span></button>
                                            }
                                            <button type="button" class="dm-reaction-add emoji-open" data-act="reaction-add" aria-label="Add reaction"><i class="fa-regular fa-face-smile"></i></button>
                                        </div>
                                    }
                                </div>
                                <div class="dm-msg-tools" role="toolbar" aria-label="Message actions">
                                    <button type="button" class="dm-react" data-act="react" aria-label="React with heart">&#10084;&#65039;</button>
                                    <button type="button" class="dm-react" data-act="react" aria-label="React with 100">&#128175;</button>
                                    <button type="button" class="dm-react" data-act="react" aria-label="React with laughing">&#128518;</button>
                                    <span class="dm-tools-sep"></span>
                                    <button type="button" class="emoji-open" data-act="picker" aria-label="Add reaction"><i class="fa-regular fa-face-smile"></i></button>
                                    @if (message.Mine)
                                    {
                                        <button type="button" data-act="edit" aria-label="Edit"><i class="fa-solid fa-pen"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" data-act="reply" aria-label="Reply"><i class="fa-solid fa-reply"></i></button>
                                    }
                                    <button type="button" data-act="forward" aria-label="Forward"><i class="fa-solid fa-share"></i></button>
                                    @if (message.Mine)
                                    {
                                        <button type="button" class="dm-tool-delete" data-act="delete" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
                                    }
                                    <button type="button" data-act="more" aria-label="More"><i class="fa-solid fa-ellipsis"></i></button>
                                </div>
                            </div>
                            previous = message;
                        }
                    }
                </div>
            </div>
            <p class="dm-error" id="dm-error" hidden></p>
            <div class="dm-reply-bar" id="dm-reply-bar" hidden>
                <span>Replying to <strong id="dm-reply-name"></strong></span>
                <button type="button" id="dm-reply-cancel" aria-label="Cancel reply"><i class="fa-solid fa-circle-xmark"></i></button>
            </div>
            <form class="dm-compose" id="dm-compose" hidden="@(chat is null)">
                <button type="button" id="dm-attach" aria-label="Add"><i class="fa-solid fa-plus"></i></button>
                <input type="file" id="dm-file" multiple hidden>
                <div class="dm-attach-menu" id="dm-attach-menu" role="menu" hidden>
                    <button type="button" role="menuitem" data-act="upload"><i class="fa-solid fa-file-arrow-up"></i><span>Upload a File</span></button>
                    <button type="button" role="menuitem" data-act="poll"><i class="fa-solid fa-square-poll-horizontal"></i><span>Create Poll</span></button>
                </div>
                <div class="dm-input-wrap">
                    <span class="dm-placeholder" id="dm-placeholder" aria-hidden="true">Message @@@shownName</span>
                    <div class="rich-text" id="dm-input" contenteditable="true" role="textbox" aria-label="Message" data-placeholder="Message @@@shownName" data-empty="1"></div>
                </div>
                <div class="dm-compose-tools">
                    <button type="button" id="dm-emoji" aria-label="Emoji"><i class="fa-regular fa-face-smile"></i></button>
                </div>
                <template id="call-face"><img alt=""></template>
                <div class="emoji-panel" id="emoji-panel" hidden></div>
            </form>
        </div>
    </section>
    <section id="dm-profile">
        <div class="dm-profile">
            <div class="dm-banner">
                <button type="button" id="dm-profile-close" aria-label="Friend options" aria-haspopup="menu" title="@(chat is null ? "" : chat.IsFriend ? "Friends" : "Not friends")"><i class="fa-solid @(chat is not null && chat.IsFriend ? "fa-user-check" : "fa-user")"></i></button>
                <button type="button" aria-label="More"><i class="fa-solid fa-ellipsis"></i></button>
            </div>
            <div id="dm-profile-info">
                <partial name="_DmProfileInfo" model="chat.ToDmProfile(Model.UtcOffsetMinutes)" />
            </div>
            <button type="button" class="dm-full">View Full Profile</button>
        </div>
    </section>
    <div class="dm-msg-menu" id="dm-msg-menu" role="menu" hidden>
        <div class="dm-menu-quick">
            <button type="button" class="dm-react" data-act="react" aria-label="React with heart">&#10084;&#65039;</button>
        </div>
        <button type="button" role="menuitem" class="emoji-open" data-menu="reaction"><i class="fa-solid fa-face-smile"></i><span>Add Reaction</span><i class="fa-solid fa-chevron-right dm-menu-arrow"></i></button>
        <hr>
        <button type="button" role="menuitem" data-menu="edit" data-own-only><i class="fa-solid fa-pen"></i><span>Edit Message</span></button>
        <button type="button" role="menuitem" data-menu="reply"><i class="fa-solid fa-reply"></i><span>Reply</span></button>
        <button type="button" role="menuitem" data-menu="forward"><i class="fa-solid fa-share"></i><span>Forward</span></button>
        <hr>
        <button type="button" role="menuitem" data-menu="copy-text"><i class="fa-solid fa-copy"></i><span>Copy Text</span></button>
        <button type="button" role="menuitem" data-menu="copy-id"><i class="fa-solid fa-fingerprint"></i><span>Copy Message ID</span></button>
        <button type="button" role="menuitem" class="is-danger" data-menu="report" data-other-only><i class="fa-solid fa-flag"></i><span>Report Message</span></button>
        <button type="button" role="menuitem" data-menu="pin"><i class="fa-solid fa-thumbtack"></i><span>Pin Message</span></button>
        <hr data-own-only>
        <button type="button" role="menuitem" class="is-danger" data-menu="delete" data-own-only><i class="fa-solid fa-trash-can"></i><span>Delete Message</span></button>
    </div>
    <div class="dm-pins-popover" id="dm-pins-popover" hidden></div>
    <div class="dm-modal" id="dm-forward-modal" role="dialog" aria-modal="true" aria-labelledby="dm-forward-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card dm-forward-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="dm-forward-title">Forward To</h2>
            <p class="dm-modal-text">Select where you want to share this message.</p>
            <label class="dm-forward-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" id="dm-forward-search" placeholder="Search" aria-label="Search" autocomplete="off">
            </label>
            <div class="dm-forward-list" id="dm-forward-list"></div>
            <div class="dm-forward-foot">
                <div class="dm-forward-preview" id="dm-forward-preview"></div>
                <p class="dm-forward-error" id="dm-forward-error" hidden></p>
                <div class="dm-forward-send">
                    <input type="text" id="dm-forward-note" maxlength="2000" placeholder="Add an optional message..." aria-label="Optional message" autocomplete="off">
                    <button type="button" id="dm-forward-submit" disabled>Send <i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>
        </div>
    </div>
    <div class="dm-modal" id="dm-pin-modal" role="dialog" aria-modal="true" aria-labelledby="dm-pin-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="dm-pin-title">Pin It. Pin It Good.</h2>
            <p class="dm-modal-text">Hey, just double checking that you want to pin this message to the current channel for posterity and greatness?</p>
            <div class="dm-pin-preview" id="dm-pin-preview"></div>
            <div class="dm-modal-actions">
                <button type="button" class="dm-modal-cancel" data-close>Cancel</button>
                <button type="button" class="dm-modal-confirm" id="dm-pin-confirm">Oh yeah. Pin it</button>
            </div>
        </div>
    </div>
    <div class="dm-modal" id="dm-poll-modal" role="dialog" aria-modal="true" aria-labelledby="dm-poll-title" hidden>
        <div class="dm-modal-backdrop" data-close></div>
        <div class="dm-modal-card dm-poll-card">
            <button type="button" class="dm-modal-x" aria-label="Close" data-close><i class="fa-solid fa-xmark"></i></button>
            <h2 id="dm-poll-title">Create a Poll</h2>
            <label class="dm-poll-label" for="dm-poll-question">Question</label>
            <input type="text" id="dm-poll-question" class="dm-poll-input" maxlength="300" placeholder="What question do you want to ask?" autocomplete="off">
            <div class="dm-poll-count"><span id="dm-poll-count">0</span> / 300</div>
            <div class="dm-poll-label">Answers</div>
            <div class="dm-poll-answers" id="dm-poll-answers"></div>
            <button type="button" class="dm-poll-add" id="dm-poll-add"><i class="fa-solid fa-plus"></i> Add another answer</button>
            <label class="dm-poll-label" for="dm-poll-duration">Duration</label>
            <select id="dm-poll-duration" class="dm-poll-input dm-poll-select">
                <option value="1">1 hour</option>
                <option value="4">4 hours</option>
                <option value="8">8 hours</option>
                <option value="24" selected>24 hours</option>
                <option value="72">3 days</option>
                <option value="168">1 week</option>
                <option value="336">2 weeks</option>
            </select>
            <p class="dm-poll-error" id="dm-poll-error" hidden></p>
            <div class="dm-poll-foot">
                <label class="dm-poll-multi"><input type="checkbox" id="dm-poll-multiple"><span>Allow Multiple Answers</span></label>
                <button type="button" class="dm-poll-post" id="dm-poll-post">Post</button>
            </div>
            <div class="dm-poll-emojis" id="dm-poll-emojis" hidden></div>
        </div>
    </div>
</main>
