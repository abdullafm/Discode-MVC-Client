@using System.Globalization
@model DmProfileUIVM
@{
    var avatar = string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/img/img-icon-profile.jpeg") : Model.AvatarUrl;
    var status = Model.HasChat && Model.Status != "online" ? " " + Model.Status : "";
    var joined = DateTime.SpecifyKind(Model.MemberSince, DateTimeKind.Utc).AddMinutes(Model.UtcOffsetMinutes);
}
@if (Model.IsPrivate)
{
    <div class="dm-private-head"><i class="fa-solid fa-lock"></i> <span>Private Profile</span></div>
}
<i class="dm-banner-data" data-banner="@Model.BannerUrl" data-color="@Model.BannerColor" hidden></i>
<div class="dm-profile-photo">
    <img class="dm-profile-avatar" id="dm-profile-avatar" src="@avatar" alt="">
    <span class="dm-status@(status)"></span>
    @if (!string.IsNullOrWhiteSpace(Model.CustomStatus))
    {
        <div class="dm-profile-bubble"><span>@Model.CustomStatus</span></div>
    }
</div>
<div class="dm-profile-card">
    <h2 id="dm-profile-name">@(Model.HasChat ? Model.Name : "")</h2>
    <div class="handle-row">
    <p id="dm-profile-handle">@Model.UserName@if (!string.IsNullOrWhiteSpace(Model.Pronouns)) { <text> • @Model.Pronouns</text> }</p>
    @if (Model.HasNitro || Model.IsBooster || !string.IsNullOrEmpty(Model.StaffRole))
    {
        <span class="nitro-badges">
            @if (Model.StaffRole == "superadmin") { <span class="nitro-badge nitro-badge-superadmin" title="Super admin"><img src="~/assets/img/badge-superadmin.png" alt="" aria-hidden="true"></span> }
            else if (Model.StaffRole == "admin") { <span class="nitro-badge nitro-badge-admin" title="Admin"><img src="~/assets/img/badge-admin.png" alt="" aria-hidden="true"></span> }
            @if (Model.HasNitro) { <span class="nitro-badge nitro-badge-nitro" title="Nitro subscriber"><img src="~/assets/img/badge-nitro.png" alt="" aria-hidden="true"></span> }
            @if (Model.IsBooster) { <span class="nitro-badge nitro-badge-boost" title="Boosting a server"><img src="~/assets/img/badge-boost.png" alt="" aria-hidden="true"></span> }
        </span>
    }
    </div>
</div>
@if (Model.IsPrivate)
{
    <p class="dm-private-note">@Model.Name's profile is private, so some info is hidden. Add them as a friend to see more.</p>
}
<div class="dm-profile-body">
    @if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
        <p class="dm-since-label">Bio</p>
        <p class="dm-profile-text">@Model.Bio</p>
    }
    <p class="dm-since-label">Member Since</p>
    <p id="dm-since">@(Model.HasChat ? joined.ToString("MMM d, yyyy", CultureInfo.InvariantCulture) : "")</p>
</div>
