@model LoginVM
@{
    Layout = "_LoginLayout";
}

<main class="login-page">
    <form class="login-card" id="login-form" asp-controller="Account" asp-action="Login" method="post">
        <h1>Welcome back!</h1>
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Email" id="login-email" type="email" autocomplete="email" required pattern=".*\S.*" placeholder="Email">
        <input asp-for="Password" id="login-pass" type="password" autocomplete="current-password" required pattern=".*\S.*" placeholder="Password">
        <button type="submit">Sign in</button>
        <p class="login-switch">Don't have an account? <a asp-controller="Account" asp-action="Register">Sign up</a></p>
    </form>
</main>
