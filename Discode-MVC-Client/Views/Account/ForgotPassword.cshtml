@model ForgotPasswordUIVM
@{
    Layout = "_LoginLayout";
}

<main class="login-page">
    <form class="login-card" id="forgot-form" asp-controller="Account" asp-action="ForgotPassword" method="post">
        <h1 data-i18n="Forgot password?">Forgot password?</h1>
        <p data-i18n="Enter the email you used to sign up. We'll send a reset link.">Enter the email you used to sign up. We'll send a reset link.</p>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-errors" asp-validation-summary="All"></div>
        }
        @if (ViewBag.Sent is true)
        {
            <p class="auth-info" data-i18n="If an account exists for this email, we sent a reset link.">If an account exists for this email, we sent a reset link.</p>
        }
        <input asp-for="Email" id="forgot-email" type="email" autocomplete="email" required pattern=".*\S.*" placeholder="Email">
        <button type="submit" data-i18n="Send reset link">Send reset link</button>
        <p class="login-switch"><span data-i18n="Remember your password?">Remember your password?</span> <a asp-controller="Account" asp-action="Login" data-i18n="Sign in">Sign in</a></p>
    </form>
</main>
