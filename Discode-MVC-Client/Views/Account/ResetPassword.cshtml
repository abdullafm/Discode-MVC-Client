@model ResetPasswordUIVM
@{
    Layout = "_LoginLayout";
    var linkOk = !string.IsNullOrWhiteSpace(Model.Email) && !string.IsNullOrWhiteSpace(Model.Token);
}

<main class="login-page">
    <form class="login-card" id="reset-form" asp-controller="Account" asp-action="ResetPassword" method="post">
        <h1 data-i18n="Choose a new password">Choose a new password</h1>
        <p data-i18n="Enter a new password for your account.">Enter a new password for your account.</p>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-errors" asp-validation-summary="All"></div>
        }
        @if (linkOk)
        {
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <input asp-for="NewPassword" id="reset-pass" type="password" autocomplete="new-password" required pattern=".*\S.*" placeholder="New password">
            <input asp-for="ConfirmPassword" id="reset-confirm" type="password" autocomplete="new-password" required pattern=".*\S.*" placeholder="Confirm password">
            <button type="submit" data-i18n="Change password">Change password</button>
        }
        else
        {
            <p class="auth-info" data-i18n="This reset link is invalid or has expired.">This reset link is invalid or has expired.</p>
            <a class="login-submit" asp-controller="Account" asp-action="ForgotPassword" data-i18n="Request a new link">Request a new link</a>
        }
        <p class="login-switch"><span data-i18n="Remember your password?">Remember your password?</span> <a asp-controller="Account" asp-action="Login" data-i18n="Sign in">Sign in</a></p>
    </form>
</main>
