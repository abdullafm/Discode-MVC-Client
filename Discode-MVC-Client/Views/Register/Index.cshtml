@{
    Layout = "_RegisterLayout";
}
<main class="x-container">
    <div class="x-content">
        <h2>Create an account</h2>
        <form class="login-card register-card" id="register-form">
            <input id="register-email" name="email" type="email" autocomplete="email" required placeholder="Email">
            <input id="register-display" name="displayName" type="text" autocomplete="nickname" maxlength="32" placeholder="Display Name">
            <input id="register-user" name="username" type="text" autocomplete="username" required maxlength="32" placeholder="Username">
            <div class="password-wrapper">
                <input id="register-pass" name="password" type="password" autocomplete="new-password" required placeholder="Password">
                <button type="button" class="toggle-password" aria-label="Toggle password visibility">
                    <i class="fa-solid fa-eye-slash"></i>
                </button>
            </div>
            <fieldset class="register-birth-field">
                <legend class="register-kicker">Date of Birth</legend>
                <div class="register-birth">
                    <div class="birth-box">
                        <button type="button" class="birth-field" aria-expanded="false" aria-controls="register-day-list">
                            <span>Day</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                        <ul class="birth-list" id="register-day-list" hidden>
                            <li><button type="button" data-value="1">1<i class="fa-solid fa-check"></i></button></li>
