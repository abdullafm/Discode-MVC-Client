@{
    Layout = "_LoginLayout";
}
    <main class="login-page">
        <form class="login-card" id="login-form" action="./index.html">
            <h1>Welcome back!</h1>
            <input id="login-email" name="email" type="email" autocomplete="email" required placeholder="Email">
            <input id="login-pass" name="password" type="password" autocomplete="current-password" required placeholder="Password">
            <button type="submit">Sign in</button>
            <p class="login-switch">Don't have an account? <a href="./register.html">Sign up</a></p>
        </form>
    </main>